---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { locales, siteConfig } from '../../config/site';
import { t } from '../../i18n/ui';
import { getLocaleFromParam } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParam(Astro.params.locale);
---

<SiteLayout locale={locale} title={siteConfig.workingTitle[locale]}>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-10 py-space-2xl">
    <p class="text-label-caps text-primary mb-space-md">{t(locale, 'scaffold.eyebrow')}</p>
    <h1 class="text-display-hero text-text-primary mb-space-md">
      {t(locale, 'scaffold.title')}
    </h1>
    <p class="font-body text-text-secondary max-w-xl mb-space-xl">
      {t(locale, 'scaffold.body')}
    </p>
    <ul class="space-y-2 text-sm text-text-secondary">
      <li>· Header: услуги (5 типов R15), телефон, RU|EN, CTA</li>
      <li>· PromoBanner: акция A</li>
      <li>· Footer: контакты-плейсхолдеры, юр. ссылки</li>
      <li>· MobileStickyBar: виден на ширине &lt; md</li>
    </ul>
  </section>
</SiteLayout>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ApplianceLanding from '../../../components/appliances/ApplianceLanding.astro';
import { ovensPage } from '../../../content/appliances/ovens';
import { siteConfig } from '../../../config/site';

const locale = 'en' as const;
const title = `Gaggenau oven repair · ${siteConfig.geo.en}`;
---

<SiteLayout
  locale={locale}
  title={title}
  description={ovensPage.subtitle.en}
  applianceSlug={ovensPage.slug}
  applianceLabel="Ovens"
  showPromo={false}
>
  <ApplianceLanding locale={locale} page={ovensPage} />
</SiteLayout>

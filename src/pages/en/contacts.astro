---
import SiteLayout from '../../layouts/SiteLayout.astro';
import UtilityPage from '../../components/utility/UtilityPage.astro';
import { getUtilityPage } from '../../content/utility';
import { withBrandTitle } from '../../content/seo';

const locale = 'en' as const;
const page = getUtilityPage('contacts');
---

<SiteLayout
  locale={locale}
  title={withBrandTitle(page.title[locale], locale)}
  description={page.description[locale]}
  showPromo={false}
>
  <UtilityPage locale={locale} page={page} />
</SiteLayout>

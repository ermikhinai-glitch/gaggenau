---
import { defaultLocale } from '../config/site';
const href = `/${defaultLocale}/`;
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${href}`} />
    <link rel="canonical" href={href} />
    <title>Redirect…</title>
  </head>
  <body>
    <p><a href={href}>Continue</a></p>
  </body>
</html>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ApplianceLanding from '../../../components/appliances/ApplianceLanding.astro';
import { appliances } from '../../../config/site';
import { getAppliancePage, listAppliancePages } from '../../../content/appliances';
import { getApplianceSeo } from '../../../content/seo';

export function getStaticPaths() {
  return listAppliancePages().map((page) => ({
    params: { slug: page.slug },
  }));
}

const locale = 'ru' as const;
const slug = Astro.params.slug ?? '';
const page = getAppliancePage(slug);
if (!page) {
  return Astro.redirect('/ru/');
}

const meta = appliances.find((a) => a.slug === page.slug);
const label = meta?.label.ru ?? page.slug;
const seo = getApplianceSeo(page.slug, locale);
---

<SiteLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  ogImage={page.heroImage}
  applianceSlug={page.slug}
  applianceLabel={label}
  showPromo={false}
>
  <ApplianceLanding locale={locale} page={page} />
</SiteLayout>

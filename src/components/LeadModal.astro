---
import { appliances, siteConfig, type Locale } from '../config/site';
import { leadCopy } from '../content/lead';
import { localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = leadCopy[locale];
const privacyHref = localizePath(locale, 'privacy');
const leadApiUrl = siteConfig.leadApiUrl;
const applianceOptions = appliances.map((a) => ({
  slug: a.slug,
  label: a.label[locale],
}));

const labelClass =
  'block text-[12px] uppercase tracking-wider text-[#c5cad3] mb-1.5 font-medium';
const inputClass =
  'w-full min-h-12 rounded-DEFAULT bg-[#0e1117] border border-white/20 px-4 py-3 text-[15px] leading-normal text-[#c5cad3] placeholder:text-[#6f7684] outline-none focus:border-primary-container focus-visible:border-primary-container focus-visible:shadow-[0_0_0_2px_rgba(197,160,89,0.25)]';
const optionalLabelClass =
  'block text-[10px] uppercase tracking-wider text-[#b8bec8] mb-1 font-medium';
const optionalInputClass =
  'w-full min-h-10 rounded-DEFAULT bg-[#0e1117] border border-white/20 px-3 py-2.5 text-[13px] leading-normal text-[#c5cad3] placeholder:text-[#6f7684] outline-none focus:border-primary-container focus-visible:border-primary-container focus-visible:shadow-[0_0_0_2px_rgba(197,160,89,0.25)]';
---

<div
  id="lead-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center p-4 bg-[rgba(12,14,18,0.88)] backdrop-blur-xl"
  data-locale={locale}
  data-copy={JSON.stringify(copy)}
  data-privacy-href={privacyHref}
  data-api-url={leadApiUrl}
  role="presentation"
>
  <div
    data-lead-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="lead-modal-title"
    class="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-lg border border-border-metallic/50 bg-[#1a1e27] p-space-lg md:p-space-xl shadow-[0_24px_64px_-16px_rgba(0,0,0,0.8)]"
  >
    <button
      type="button"
      data-lead-close
      class="absolute top-4 right-4 text-[#a3a8b5] hover:text-[#f4f5f7] transition"
      aria-label={copy.close}
    >
      ✕
    </button>

    <div data-lead-form-view>
      <h2 id="lead-modal-title" class="font-display text-xl text-[#f4f5f7] mb-2 pr-8">
        {copy.title}
      </h2>
      <p data-lead-notice class="text-sm text-[#c5cad3] mb-space-md leading-relaxed"></p>

      <div
        data-lead-errors
        class="hidden mb-space-md rounded-DEFAULT border border-error/40 bg-error/10 px-3 py-2 text-xs text-error"
        role="alert"
      >
      </div>

      <form data-lead-form class="space-y-space-md" novalidate autocomplete="off">
        <div>
          <label class={labelClass} for="lead-name">
            {copy.name}*
          </label>
          <input
            id="lead-name"
            name="lead_client_name"
            type="text"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="words"
            spellcheck="false"
            data-lead-name
            required
            placeholder={locale === 'ru' ? 'Как к вам обращаться' : 'Your name'}
            class={`lux-field ${inputClass}`}
          />
        </div>

        <div>
          <label class={labelClass} for="lead-phone">
            {copy.phone}*
          </label>
          {/* type=text + non-phone name reduces browser phone history suggestions */}
          <input
            id="lead-phone"
            name="lead_client_phone"
            type="text"
            autocomplete="new-password"
            inputmode="numeric"
            maxlength="18"
            placeholder="+7 (___) ___-__-__"
            data-lead-phone
            data-lpignore="true"
            data-1p-ignore="true"
            data-bwignore="true"
            readonly
            required
            class={`lux-field ${inputClass} font-tech tracking-wide`}
          />
        </div>

        <label class="flex items-start gap-3 text-sm text-[#d1d5de] leading-relaxed cursor-pointer">
          <input
            name="consent"
            type="checkbox"
            required
            data-lead-consent
            class="lux-checkbox mt-0.5"
          />
          <span>
            {copy.consent}
            {' '}
            <a
              data-lead-privacy-link
              href={privacyHref}
              class="text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              ({copy.privacy})
            </a>
          </span>
        </label>

        <details
          data-lead-optional
          class="surface-lux-glow group rounded-DEFAULT border bg-[#141820]"
        >
          <summary
            class="cursor-pointer list-none px-4 py-3.5 flex items-center justify-between gap-3 select-none"
          >
            <span>
              <span class="block text-[12px] uppercase tracking-wider text-[#e2e5ec] font-medium">
                {copy.optional}
              </span>
              <span class="block text-xs text-[#a3a8b5] mt-0.5 group-open:hidden">
                {copy.optionalHint}
              </span>
            </span>
            <span
              class="text-primary text-sm transition-transform duration-200 group-open:rotate-180"
              aria-hidden="true"
            >
              ▾
            </span>
          </summary>

          <div class="px-4 pb-4 pt-1 space-y-2.5 border-t border-white/10">
            <div>
              <label class={optionalLabelClass} for="lead-city">{copy.city}</label>
              <select
                id="lead-city"
                name="city"
                data-lead-city
                class="lux-select lux-select--empty"
              >
                <option value="">{copy.cityEmpty}</option>
                <option value={copy.cityMoscow}>{copy.cityMoscow}</option>
                <option value={copy.cityMO}>{copy.cityMO}</option>
              </select>
            </div>

            <div>
              <label class={optionalLabelClass} for="lead-time">{copy.time}</label>
              <select
                id="lead-time"
                name="time"
                data-lead-time
                class="lux-select lux-select--empty"
              >
                <option value="">{copy.timeEmpty}</option>
                <option value={copy.timeSoon}>{copy.timeSoon}</option>
                <option value={copy.timeMorning}>{copy.timeMorning}</option>
                <option value={copy.timeDay}>{copy.timeDay}</option>
                <option value={copy.timeEvening}>{copy.timeEvening}</option>
              </select>
            </div>

            <div>
              <label class={optionalLabelClass} for="lead-appliance">{copy.appliance}</label>
              <select
                id="lead-appliance"
                name="applianceSlug"
                data-lead-appliance
                class="lux-select lux-select--empty"
              >
                <option value="">{copy.applianceEmpty}</option>
                {
                  applianceOptions.map((opt) => (
                    <option value={opt.slug}>{opt.label}</option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class={optionalLabelClass} for="lead-problem">{copy.problem}</label>
              <textarea
                id="lead-problem"
                name="problem"
                rows="2"
                class={`${optionalInputClass} resize-none`}
              ></textarea>
            </div>

          </div>
        </details>

        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <button
          type="submit"
          data-lead-submit
          class="btn-lead-glow w-full h-12 rounded-DEFAULT bg-primary-container text-on-primary-container text-sm font-semibold uppercase tracking-wider active:scale-[0.99]"
        >
          {copy.submit}
        </button>
      </form>
    </div>

    <div data-lead-success-view class="hidden text-center py-8">
      <p class="text-label-caps text-primary mb-3">{copy.successTitle}</p>
      <p data-lead-success-text class="text-base text-[#f4f5f7] leading-relaxed mb-space-xl"></p>
      <button
        type="button"
        data-lead-close
        class="btn-outline-glow inline-flex h-11 items-center justify-center rounded-DEFAULT border px-8 font-tech text-tech-data uppercase tracking-wider text-[#f4f5f7]"
      >
        {copy.close}
      </button>
    </div>
  </div>
</div>

<script>
  import { initLeadModal } from '../scripts/lead-modal';

  const root = document.getElementById('lead-modal');
  if (root) initLeadModal(root);
</script>

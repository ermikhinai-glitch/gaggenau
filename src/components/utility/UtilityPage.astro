---
import { siteConfig, type Locale } from '../../config/site';
import type { UtilityPageContent } from '../../content/utility';
import { t } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

interface Props {
  locale: Locale;
  page: UtilityPageContent;
}

const { locale, page } = Astro.props;
const isContacts = page.slug === 'contacts';
const isWarranty = page.slug === 'warranty';
---

<div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 pt-space-md pb-space-xs">
  <nav class="flex flex-wrap items-center gap-2 text-[11px] text-text-tertiary" aria-label="Breadcrumb">
    <a href={localizePath(locale)} class="hover:text-primary transition-colors">
      {locale === 'ru' ? 'Главная' : 'Home'}
    </a>
    <span class="opacity-40">/</span>
    <span class="text-text-secondary">{page.title[locale]}</span>
  </nav>
</div>

<section
  class:list={[
    'mx-auto px-4 sm:px-6 lg:px-10 pt-space-lg pb-space-3xl motion-fade-up',
    isWarranty ? 'max-w-[1100px]' : 'max-w-[900px]',
  ]}
>
  <p class="text-label-caps text-primary mb-3">{page.eyebrow[locale]}</p>
  <h1 class="text-headline-lg text-text-primary uppercase mb-space-md">{page.title[locale]}</h1>
  <p class="text-base sm:text-lg text-text-secondary leading-relaxed mb-space-xl">
    {page.lead[locale]}
  </p>

  {
    page.draftNote && (
      <p class="mb-space-xl rounded-DEFAULT border border-status-warning/35 bg-status-warning/10 px-4 py-3 text-sm text-status-warning leading-relaxed">
        {page.draftNote[locale]}
      </p>
    )
  }

  {
    isContacts && (
      <div class="mb-space-2xl grid gap-4 sm:grid-cols-2">
        <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
          <p class="text-label-caps text-primary mb-2">{locale === 'ru' ? 'Телефон' : 'Phone'}</p>
          <div class="flex flex-col gap-2">
            {
              siteConfig.phones.map((phone) => (
                <a
                  href={phone.href}
                  class="font-tech text-tech-data-lg text-text-primary hover:text-primary transition-colors"
                >
                  {phone.display}
                </a>
              ))
            }
          </div>
        </div>
        <a
          href={`mailto:${siteConfig.email}`}
          class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg"
        >
          <p class="text-label-caps text-primary mb-2">Email</p>
          <p class="text-base text-text-primary break-all">{siteConfig.email}</p>
        </a>
        <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg sm:col-span-2">
          <p class="text-label-caps text-primary mb-2">{locale === 'ru' ? 'Режим' : 'Hours'}</p>
          <p class="text-base text-text-primary">{siteConfig.hours.label[locale]}</p>
          <p class="mt-2 text-sm text-text-tertiary">{siteConfig.geo[locale]}</p>
        </div>
        <div class="sm:col-span-2 flex flex-col sm:flex-row gap-3">
          <button
            type="button"
            data-open-lead-modal
            class="btn-lead-glow inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container"
          >
            {t(locale, 'cta.request')}
          </button>
          <a
            href={siteConfig.phoneHref}
            class="btn-outline-glow inline-flex h-12 items-center justify-center rounded-DEFAULT border px-8 font-tech text-tech-data uppercase tracking-wider text-text-primary"
          >
            {t(locale, 'cta.call')} {siteConfig.phoneDisplay}
          </a>
        </div>
      </div>
    )
  }

  {
    isWarranty ? (
      <div class="grid gap-4 sm:grid-cols-2">
        {page.sections.map((section, index) => (
          <section class="card-lux-glow rounded-DEFAULT border bg-surface-raised/70 p-space-lg">
            <p class="font-tech text-[11px] tracking-wider text-primary mb-2">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h2 class="font-display text-xl text-text-primary mb-space-sm">{section.title[locale]}</h2>
            <div class="space-y-2">
              {section.paragraphs.map((paragraph) => (
                <p class="text-sm text-text-secondary leading-relaxed">{paragraph[locale]}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="space-y-space-xl">
        {page.sections.map((section) => (
          <section class="surface-lux-glow rounded-DEFAULT border bg-surface-raised/50 p-space-lg">
            <h2 class="font-display text-xl text-text-primary mb-space-md">{section.title[locale]}</h2>
            <div class="space-y-3">
              {section.paragraphs.map((paragraph) => (
                <p class="text-sm sm:text-base text-text-secondary leading-relaxed">{paragraph[locale]}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }

  {
    (page.slug === 'about' || page.slug === 'privacy' || page.slug === 'terms' || isWarranty) && (
      <div class="mt-space-2xl pt-space-xl border-t border-hairline flex flex-col sm:flex-row gap-3">
        <a
          href={localizePath(locale, 'contacts')}
          class="btn-outline-glow inline-flex h-12 items-center justify-center rounded-DEFAULT border px-6 font-tech text-tech-data uppercase tracking-wider text-primary hover:bg-white/5"
        >
          {locale === 'ru' ? 'Контакты' : 'Contacts'} →
        </a>
        <button
          type="button"
          data-open-lead-modal
          class="btn-lead-glow inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container"
        >
          {t(locale, 'cta.request')}
        </button>
      </div>
    )
  }
</section>

---
import { promoA } from '../content/promo';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
const promo = promoA;
const eyebrow = locale === 'ru' ? 'Акция' : 'Offer';
---

<section id="promo" class="w-full px-4 sm:px-6 lg:px-10 py-space-xl border-y border-border-metallic/30 bg-surface-container-lowest">
  <div
    class="mx-auto max-w-[1520px] rounded-lg border border-border-metallic bg-gradient-to-br from-[#1c2029] to-[#14171d] p-space-lg md:p-space-xl flex flex-col md:flex-row md:items-center md:justify-between gap-space-lg shadow-[0_0_40px_-12px_rgba(197,160,89,0.35)]"
  >
    <div class="max-w-2xl space-y-space-sm">
      <p class="text-label-caps text-primary tracking-[0.14em]">{eyebrow}</p>
      <h2 class="font-display text-xl md:text-2xl font-medium text-text-primary tracking-tight">
        {promo.title[locale]}
      </h2>
      <p class="text-sm md:text-[15px] text-text-secondary leading-relaxed">
        {promo.subtitle[locale]}
      </p>
      <p class="text-[11px] text-text-tertiary leading-relaxed">
        {promo.fineprint[locale]}
      </p>
    </div>
    <button
      type="button"
      data-open-lead-modal
      data-appliance-prefill={applianceSlug}
      data-appliance-label={applianceLabel}
      class="btn-lead-glow shrink-0 inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-space-xl text-[13px] font-semibold uppercase tracking-wider text-on-primary-container active:scale-[0.98]"
    >
      {promo.cta[locale]}
    </button>
  </div>
</section>

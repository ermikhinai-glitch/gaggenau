---
import { appliances, siteConfig, type Locale } from '../../config/site';
import { homeContent } from '../../content/home';
import PromoBanner from '../PromoBanner.astro';
import { t } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeContent;
---

<!-- Hero -->
<section class="relative min-h-[88vh] flex items-center overflow-hidden border-b border-hairline">
  <div class="absolute inset-0 z-0">
    <img
      src="/images/home/hero-kitchen.png"
      alt=""
      class="h-full w-full object-cover object-center brightness-[0.72] contrast-[1.05] scale-105 motion-hero-bg"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-surface-base via-surface-base/85 to-surface-base/35"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-surface-base via-transparent to-surface-base/70"></div>
  </div>

  <div class="relative z-10 w-full max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 py-16 lg:py-24 motion-fade-up">
    <div
      class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-surface-container/90 border border-primary/30 backdrop-blur-md mb-6"
    >
      <span class="w-2 h-2 rounded-full bg-status-active shadow-[0_0_8px_#4ade80]"></span>
      <span class="text-label-caps text-status-warning tracking-[0.16em]">{c.hero.badge[locale]}</span>
    </div>

    <h1 class="max-w-4xl text-display-hero text-text-primary uppercase mb-6">
      {c.hero.titleLead[locale]}
      <span class="text-primary"> {c.hero.titleAccent[locale]}</span>
    </h1>

    <p class="max-w-2xl text-base sm:text-lg text-text-secondary leading-relaxed mb-10">
      {c.hero.subtitle[locale]}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 mb-14 max-w-xl">
      <button
        type="button"
        data-open-lead-modal
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container shadow-[0_0_24px_rgba(197,160,89,0.3)] hover:brightness-110 transition active:scale-[0.98]"
      >
        {t(locale, 'cta.request')}
      </button>
      <a
        href={siteConfig.phoneHref}
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT border border-white/20 bg-surface-raised/90 px-8 font-tech text-tech-data uppercase tracking-wider text-text-primary hover:border-primary transition"
      >
        {siteConfig.phoneDisplay}
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-6 border-t border-white/10">
      {
        c.sla.map((item) => (
          <div class="p-4 sm:p-5 rounded-DEFAULT border border-hairline bg-surface-raised/80 backdrop-blur-md hover:border-border-metallic transition-colors">
            <div class="text-label-caps text-primary mb-2">{item.label[locale]}</div>
            <div class="text-tech-data-lg text-text-primary mb-1">{item.value[locale]}</div>
            <p class="text-xs text-text-secondary leading-snug">{item.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Appliances -->
<section class="py-space-2xl md:py-space-3xl bg-[#0e1015]" id="appliances">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-space-xl">
      <div>
        <p class="text-label-caps text-primary mb-2">{c.appliancesSection.eyebrow[locale]}</p>
        <h2 class="text-headline-lg text-text-primary uppercase">{c.appliancesSection.title[locale]}</h2>
      </div>
      <p class="max-w-md text-sm text-text-secondary">{c.appliancesSection.lead[locale]}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">
      {
        appliances.map((item, index) => {
          const card = c.applianceCards[item.slug];
          return (
            <a
              href={localizePath(locale, item.path)}
              class="group flex flex-col justify-between min-h-[420px] rounded-DEFAULT border border-hairline bg-surface-raised/70 p-5 hover:border-border-metallic transition-all duration-300 hover:-translate-y-0.5"
            >
              <div>
                <div class="relative h-40 mb-4 overflow-hidden rounded-DEFAULT border border-hairline bg-black/40">
                  <img
                    src={card.image}
                    alt=""
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface-raised via-transparent to-transparent" />
                </div>
                <p class="text-label-caps text-primary mb-1">{card.series[locale]}</p>
                <h3 class="font-display text-lg text-text-primary mb-2 group-hover:text-primary transition-colors">
                  {item.label[locale]}
                </h3>
                <p class="text-xs text-text-secondary leading-relaxed">{card.description[locale]}</p>
              </div>
              <div class="mt-6 pt-4 border-t border-hairline flex items-center justify-between">
                <span class="font-tech text-xs uppercase tracking-wider text-primary">
                  {c.appliancesSection.more[locale]} →
                </span>
                <span class="font-tech text-[11px] text-text-tertiary">
                  {String(index + 1).padStart(2, '0')} / 05
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<!-- Process -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline" id="process">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.process.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{c.process.title[locale]}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        c.process.steps.map((step) => (
          <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
            <div class="text-tech-data-lg text-primary mb-3">{step.n}</div>
            <h3 class="font-display text-lg text-text-primary mb-2">{step.title[locale]}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{step.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Terms -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.terms.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{c.terms.title[locale]}</h2>
    <p class="max-w-3xl text-text-secondary leading-relaxed border border-border-metallic/40 rounded-DEFAULT p-space-lg bg-surface-raised/60">
      {c.terms.body[locale]}
    </p>
  </div>
</section>

<PromoBanner locale={locale} />

<!-- Trust -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-space-xl items-center">
    <div class="lg:col-span-5 relative overflow-hidden rounded-DEFAULT border border-hairline min-h-[280px]">
      <img src="/images/home/trust.png" alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-base via-transparent to-transparent"></div>
    </div>
    <div class="lg:col-span-7">
      <p class="text-label-caps text-primary mb-2">{c.trust.eyebrow[locale]}</p>
      <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">{c.trust.title[locale]}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          c.trust.points.map((point) => (
            <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-md">
              <h3 class="font-display text-base text-text-primary mb-1">{point.title[locale]}</h3>
              <p class="text-sm text-text-secondary">{point.text[locale]}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Reviews placeholder -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-space-lg">
      <div>
        <p class="text-label-caps text-primary mb-2">{c.reviews.eyebrow[locale]}</p>
        <h2 class="text-headline-lg text-text-primary uppercase">{c.reviews.title[locale]}</h2>
      </div>
      <span class="inline-flex rounded-full border border-status-warning/40 px-3 py-1 text-[11px] font-tech uppercase tracking-wider text-status-warning">
        {c.reviews.badge[locale]}
      </span>
    </div>
    <p class="text-sm text-text-tertiary mb-space-lg max-w-2xl">{c.reviews.note[locale]}</p>
    <div class="grid md:grid-cols-3 gap-4">
      {
        c.reviews.items.map((item) => (
          <blockquote class="rounded-DEFAULT border border-dashed border-white/15 bg-surface-raised/50 p-space-lg">
            <p class="text-sm text-text-secondary leading-relaxed mb-space-md">“{item.text[locale]}”</p>
            <footer class="text-tech-data text-text-tertiary">{item.name[locale]}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline" id="faq">
  <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.faq.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{c.faq.title[locale]}</h2>
    <div class="space-y-3" data-faq>
      {
        c.faq.items.map((item) => (
          <details class="group rounded-DEFAULT border border-hairline bg-surface-raised open:border-border-metallic transition-colors">
            <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4 font-display text-base text-text-primary">
              <span>{item.q[locale]}</span>
              <span class="text-primary transition group-open:rotate-180">▾</span>
            </summary>
            <div class="px-5 pb-5 text-sm text-text-secondary leading-relaxed">{item.a[locale]}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- About teaser -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]" id="about">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 flex flex-col md:flex-row md:items-end justify-between gap-space-lg">
    <div class="max-w-2xl">
      <p class="text-label-caps text-primary mb-2">{c.about.eyebrow[locale]}</p>
      <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{c.about.title[locale]}</h2>
      <p class="text-text-secondary leading-relaxed">{c.about.body[locale]}</p>
    </div>
    <a
      href={localizePath(locale, 'about')}
      class="inline-flex h-12 items-center justify-center rounded-DEFAULT border border-border-metallic px-6 font-tech text-tech-data uppercase tracking-wider text-primary hover:bg-white/5 transition"
    >
      {c.about.link[locale]} →
    </a>
  </div>
</section>

<!-- Bottom CTA -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/10 pointer-events-none"></div>
  <div class="relative max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 text-center">
    <h2 class="text-headline-lg text-text-primary uppercase mb-4 max-w-3xl mx-auto">
      {c.bottomCta.title[locale]}
    </h2>
    <p class="text-text-secondary mb-space-xl max-w-xl mx-auto">{c.bottomCta.text[locale]}</p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button
        type="button"
        data-open-lead-modal
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container shadow-[0_0_24px_rgba(197,160,89,0.3)]"
      >
        {t(locale, 'cta.request')}
      </button>
      <a
        href={siteConfig.phoneHref}
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT border border-white/20 px-8 font-tech text-tech-data uppercase tracking-wider text-text-primary hover:border-primary transition"
      >
        {t(locale, 'cta.call')} · {siteConfig.phoneDisplay}
      </a>
    </div>
  </div>
</section>

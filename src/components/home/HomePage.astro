---
import { appliances, type Locale } from '../../config/site';
import { homeContent } from '../../content/home';
import CallPhonePicker from '../CallPhonePicker.astro';
import MobileHome from './MobileHome.astro';
import PromoBanner from '../PromoBanner.astro';
import { t } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = homeContent;
---

<MobileHome locale={locale} />
<div class="hidden md:contents">

<!-- Hero: height = viewport minus fixed header (main pt-20); inner min-h forces justify-between -->
<section
  class="relative -mt-20 min-h-[100svh] flex flex-col border-b border-hairline"
>
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/home/hero-kitchen.webp"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[center_30%] brightness-[0.72] contrast-[1.05] scale-105 motion-hero-bg"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0c0e12] via-[#0c0e12]/85 to-[#0c0e12]/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c0e12] via-transparent to-[#0c0e12]/70"></div>
  </div>

  <div
    class="relative z-10 flex min-h-[100svh] w-full max-w-[1520px] mx-auto flex-col justify-between gap-10 px-4 pt-28 pb-8 sm:px-6 sm:pt-32 sm:pb-10 lg:px-10 lg:pt-36 lg:pb-12 motion-fade-up"
  >
    <div class="max-w-3xl">
      <div
        class="surface-lux-glow mb-6 inline-flex w-fit items-center gap-2.5 rounded-full border bg-surface-container/90 px-3.5 py-1.5 backdrop-blur-md lg:mb-8"
      >
        <span class="h-2 w-2 rounded-full bg-status-active shadow-[0_0_8px_#4ade80]"></span>
        <span class="text-label-caps tracking-[0.16em] text-status-warning">{c.hero.badge[locale]}</span>
      </div>

      <h1 class="mb-6 text-display-hero uppercase text-text-primary lg:mb-8">
        <span class="block tracking-[0.01em]">{c.hero.titleLead[locale]}</span>
        <span class="text-brand-mark mt-3 block text-primary lg:mt-4">
          {c.hero.titleAccent[locale]}
        </span>
      </h1>

      <p
        class="mb-8 max-w-xl rounded-DEFAULT border border-white/10 bg-[#0c0e12]/50 px-5 py-4 text-lg leading-relaxed text-[#e8eaef] backdrop-blur-md sm:text-xl lg:mb-10"
      >
        {c.hero.subtitle[locale]}
      </p>

      <div class="flex max-w-xl flex-col gap-4 sm:flex-row">
        <button
          type="button"
          data-open-lead-modal
          class="btn-lead-glow inline-flex h-14 items-center justify-center rounded-DEFAULT bg-primary-container px-10 text-sm font-semibold uppercase tracking-wider text-on-primary-container active:scale-[0.98]"
        >
          {t(locale, 'cta.request')}
        </button>
        <CallPhonePicker
          locale={locale}
          buttonClass="h-14 w-full px-10 sm:w-auto"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-3 border-t border-white/10 pt-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      {
        c.sla.map((item) => {
          const className =
            'surface-lux-glow flex min-h-[128px] flex-col justify-center rounded-DEFAULT border bg-[#14171d]/85 p-5 backdrop-blur-md transition-colors hover:border-primary sm:min-h-[140px] sm:p-6'
          const href = 'href' in item ? item.href : undefined;
          const Tag = href ? 'a' : 'div';
          return (
            <Tag
              href={href ? localizePath(locale, href) : undefined}
              class={className}
            >
              <div class="mb-2 text-label-caps text-primary">{item.label[locale]}</div>
              <div class="mb-2 text-tech-data-lg text-text-primary">{item.value[locale]}</div>
              <p class="text-sm leading-snug text-[#c5cad3]">{item.text[locale]}</p>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<!-- Appliances -->
<section class="scroll-mt-20 py-space-2xl md:py-space-3xl bg-[#0e1015]" id="appliances">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-space-xl">
      <div>
        <p class="text-label-caps text-primary mb-2">{c.appliancesSection.eyebrow[locale]}</p>
        <h2 class="text-headline-lg text-text-primary uppercase">{c.appliancesSection.title[locale]}</h2>
      </div>
      <p class="max-w-md text-sm text-text-secondary">{c.appliancesSection.lead[locale]}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      {
        appliances
          .filter((item) => item.slug !== 'wine-cabinets')
          .map((item, index, list) => {
            const total = String(list.length).padStart(2, '0');
            const indexLabel = `${String(index + 1).padStart(2, '0')} / ${total}`;
            if (item.slug === 'refrigerators') {
              const wine = appliances.find((entry) => entry.slug === 'wine-cabinets')!;
              const fridgeCard = c.applianceCards[item.slug];
              const wineCard = c.applianceCards[wine.slug];
              return (
                <a
                  href={localizePath(locale, item.path)}
                  class="card-lux-glow group flex min-h-[420px] rounded-DEFAULT border bg-surface-raised/70 p-4 motion-safe:hover:-translate-y-0.5"
                >
                  <div class="relative flex min-h-[388px] w-full flex-1 overflow-hidden rounded-DEFAULT border border-hairline">
                    <div class="absolute inset-0 grid grid-cols-2">
                      <img
                        src={fridgeCard.image}
                        alt={item.label[locale]}
                        width="900"
                        height="600"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-105"
                      />
                      <img
                        src={wineCard.image}
                        alt={wine.label[locale]}
                        width="900"
                        height="600"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-105"
                      />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-[#0c0e12] via-[#0c0e12]/75 to-[#0c0e12]/15" />
                    <div class="relative z-10 mt-auto flex w-full flex-col justify-end p-5 pt-24">
                      <h3 class="font-display text-lg text-primary mb-2">
                        {item.label[locale]}
                        <span> · </span>
                        {wine.label[locale]}
                      </h3>
                      <p class="text-xs text-[#c5cad3] leading-relaxed mb-5">
                        {locale === 'ru'
                          ? 'Холодильники и винные шкафы Gaggenau: охлаждение, температура зон, влажность и электроника.'
                          : 'Gaggenau refrigerators and wine cabinets: cooling, zone temperature, humidity and electronics.'}
                      </p>
                      <div class="pt-4 border-t border-white/15 flex items-center justify-between">
                        <span class="font-tech text-xs uppercase tracking-wider text-primary">
                          {c.appliancesSection.more[locale]} →
                        </span>
                        <span class="font-tech text-[11px] text-[#a3a8b5]">{indexLabel}</span>
                      </div>
                    </div>
                  </div>
                </a>
              );
            }
            const card = c.applianceCards[item.slug];
            return (
              <a
                href={localizePath(locale, item.path)}
                class="card-lux-glow group flex min-h-[420px] rounded-DEFAULT border bg-surface-raised/70 p-4 motion-safe:hover:-translate-y-0.5"
              >
                <div class="relative flex min-h-[388px] w-full flex-1 overflow-hidden rounded-DEFAULT border border-hairline">
                  <img
                    src={card.image}
                    alt={item.label[locale]}
                    width="900"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0c0e12] via-[#0c0e12]/75 to-[#0c0e12]/15" />
                  <div class="relative z-10 mt-auto flex w-full flex-col justify-end p-5 pt-24">
                    <h3 class="font-display text-lg text-primary mb-2">
                      {item.label[locale]}
                    </h3>
                    <p class="text-xs text-[#c5cad3] leading-relaxed mb-5">{card.description[locale]}</p>
                    <div class="pt-4 border-t border-white/15 flex items-center justify-between">
                      <span class="font-tech text-xs uppercase tracking-wider text-primary">
                        {c.appliancesSection.more[locale]} →
                      </span>
                      <span class="font-tech text-[11px] text-[#a3a8b5]">{indexLabel}</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })
      }
    </div>
  </div>
</section>

<!-- Process -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline" id="process">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.process.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{c.process.title[locale]}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        c.process.steps.map((step) => (
          <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
            <div class="text-tech-data-lg text-primary mb-3">{step.n}</div>
            <h3 class="font-display text-lg text-text-primary mb-2">{step.title[locale]}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{step.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Terms -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.terms.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{c.terms.title[locale]}</h2>
    <p class="surface-lux-glow max-w-3xl text-text-secondary leading-relaxed border rounded-DEFAULT p-space-lg bg-surface-raised/60">
      {c.terms.body[locale]}
    </p>
  </div>
</section>

<PromoBanner locale={locale} />

<!-- Trust -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 grid lg:grid-cols-12 gap-space-xl items-center">
    <div class="card-lux-glow lg:col-span-5 relative overflow-hidden rounded-DEFAULT border min-h-[280px]">
      <img
        src="/images/home/trust.webp"
        alt=""
        width="1400"
        height="900"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-base via-transparent to-transparent"></div>
    </div>
    <div class="lg:col-span-7">
      <p class="text-label-caps text-primary mb-2">{c.trust.eyebrow[locale]}</p>
      <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">{c.trust.title[locale]}</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          c.trust.points.map((point) => (
            <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-md">
              <h3 class="font-display text-base text-text-primary mb-1">{point.title[locale]}</h3>
              <p class="text-sm text-text-secondary">{point.text[locale]}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Reviews placeholder -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-space-lg">
      <div>
        <p class="text-label-caps text-primary mb-2">{c.reviews.eyebrow[locale]}</p>
        <h2 class="text-headline-lg text-text-primary uppercase">{c.reviews.title[locale]}</h2>
      </div>
      <span class="inline-flex rounded-full border border-status-warning/40 px-3 py-1 text-[11px] font-tech uppercase tracking-wider text-status-warning">
        {c.reviews.badge[locale]}
      </span>
    </div>
    <p class="text-sm text-text-tertiary mb-space-lg max-w-2xl">{c.reviews.note[locale]}</p>
    <div class="grid md:grid-cols-3 gap-4">
      {
        c.reviews.items.map((item) => (
          <blockquote class="rounded-DEFAULT border border-dashed border-white/15 bg-surface-raised/50 p-space-lg">
            <p class="text-sm text-text-secondary leading-relaxed mb-space-md">“{item.text[locale]}”</p>
            <footer class="text-tech-data text-text-tertiary">{item.name[locale]}</footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline" id="faq">
  <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{c.faq.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{c.faq.title[locale]}</h2>
    <div class="space-y-3" data-faq>
      {
        c.faq.items.map((item) => (
          <details class="surface-lux-glow group rounded-DEFAULT border bg-surface-raised">
            <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4 font-display text-base text-text-primary">
              <span>{item.q[locale]}</span>
              <span class="text-primary transition group-open:rotate-180">▾</span>
            </summary>
            <div class="px-5 pb-5 text-sm text-text-secondary leading-relaxed">{item.a[locale]}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- About teaser -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]" id="about">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 flex flex-col md:flex-row md:items-end justify-between gap-space-lg">
    <div class="max-w-2xl">
      <p class="text-label-caps text-primary mb-2">{c.about.eyebrow[locale]}</p>
      <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{c.about.title[locale]}</h2>
      <p class="text-text-secondary leading-relaxed">{c.about.body[locale]}</p>
    </div>
    <a
      href={localizePath(locale, 'about')}
      class="btn-outline-glow inline-flex h-12 items-center justify-center rounded-DEFAULT border px-6 font-tech text-tech-data uppercase tracking-wider text-primary hover:bg-white/5"
    >
      {c.about.link[locale]} →
    </a>
  </div>
</section>

<!-- Bottom CTA -->
<section class="py-space-2xl md:py-space-3xl border-t border-hairline relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/10 pointer-events-none"></div>
  <div class="relative max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 text-center">
    <h2 class="text-headline-lg text-text-primary uppercase mb-4 max-w-3xl mx-auto">
      {c.bottomCta.title[locale]}
    </h2>
    <p class="text-text-secondary mb-space-xl max-w-xl mx-auto">{c.bottomCta.text[locale]}</p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button
        type="button"
        data-open-lead-modal
        class="btn-lead-glow inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container"
      >
        {t(locale, 'cta.request')}
      </button>
      <CallPhonePicker locale={locale} />
    </div>
  </div>
</section>
</div>

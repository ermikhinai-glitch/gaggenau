---
import { siteConfig, type Locale } from '../config/site';
import { homeContent } from '../content/home';
import { leadCopy } from '../content/lead';
import { localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeContent.reviews.form;
const lead = leadCopy[locale];
const privacyHref = localizePath(locale, 'privacy');

const labelClass =
  'block text-[12px] uppercase tracking-wider text-[#c5cad3] mb-1.5 font-medium';
const inputClass =
  'w-full min-h-12 rounded-DEFAULT bg-[#0e1117] border border-white/20 px-4 py-3 text-[15px] leading-normal text-[#c5cad3] placeholder:text-[#6f7684] outline-none focus:border-primary-container focus-visible:border-primary-container focus-visible:shadow-[0_0_0_2px_rgba(197,160,89,0.25)]';
---

<div
  id="review-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center p-4 bg-[rgba(12,14,18,0.88)] backdrop-blur-xl"
  data-locale={locale}
  data-api-url={siteConfig.reviewApiUrl}
  data-copy={JSON.stringify({
    submitting: copy.submitting[locale],
    submit: copy.submit[locale],
    errorName: copy.errorName[locale],
    errorCity: copy.errorCity[locale],
    errorText: copy.errorText[locale],
    errorConsent: copy.errorConsent[locale],
    errorNetwork: copy.errorNetwork[locale],
  })}
  role="presentation"
>
  <div
    data-review-dialog
    role="dialog"
    aria-modal="true"
    aria-labelledby="review-modal-title"
    class="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-lg border border-border-metallic/50 bg-[#1a1e27] p-space-lg md:p-space-xl shadow-[0_24px_64px_-16px_rgba(0,0,0,0.8)]"
  >
    <button
      type="button"
      data-review-close
      class="absolute top-4 right-4 text-[#a3a8b5] hover:text-[#f4f5f7] transition"
      aria-label={copy.close[locale]}
    >
      ✕
    </button>

    <div data-review-form-view>
      <h2 id="review-modal-title" class="font-display text-xl text-[#f4f5f7] mb-2 pr-8">
        {copy.title[locale]}
      </h2>
      <p class="text-sm text-[#c5cad3] mb-space-md leading-relaxed">{copy.lead[locale]}</p>

      <div
        data-review-errors
        class="hidden mb-space-md rounded-DEFAULT border border-error/40 bg-error/10 px-3 py-2 text-xs text-error"
        role="alert"
      >
      </div>

      <form data-review-form class="space-y-space-md" novalidate autocomplete="off">
        <div>
          <label class={labelClass} for="review-name">{copy.name[locale]}*</label>
          <input
            id="review-name"
            name="name"
            type="text"
            maxlength="80"
            autocomplete="name"
            data-review-name
            required
            placeholder={copy.namePh[locale]}
            class={`lux-field ${inputClass}`}
          />
        </div>

        <div>
          <label class={labelClass} for="review-city">{copy.city[locale]}*</label>
          <input
            id="review-city"
            name="city"
            type="text"
            maxlength="80"
            autocomplete="address-level2"
            data-review-city
            required
            placeholder={copy.cityPh[locale]}
            class={`lux-field ${inputClass}`}
          />
        </div>

        <div>
          <label class={labelClass} for="review-text">{copy.text[locale]}*</label>
          <textarea
            id="review-text"
            name="text"
            rows="4"
            maxlength="800"
            data-review-text
            required
            placeholder={copy.textPh[locale]}
            class={`lux-field ${inputClass} min-h-[7rem] resize-none`}
          ></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-[#d1d5de] leading-relaxed cursor-pointer">
          <input
            name="consent"
            type="checkbox"
            required
            data-review-consent
            class="lux-checkbox mt-0.5"
          />
          <span>
            {copy.consent[locale]}
            {' '}
            <a
              href={privacyHref}
              class="text-primary hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              ({lead.privacy})
            </a>
          </span>
        </label>

        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        <button
          type="submit"
          data-review-submit
          class="btn-lead-glow w-full h-12 rounded-DEFAULT bg-primary-container text-on-primary-container text-sm font-semibold uppercase tracking-wider active:scale-[0.99]"
        >
          {copy.submit[locale]}
        </button>
      </form>
    </div>

    <div data-review-success-view class="hidden text-center py-8">
      <p class="text-label-caps text-primary mb-3">{copy.successTitle[locale]}</p>
      <p class="text-base text-[#f4f5f7] leading-relaxed mb-space-xl">{copy.success[locale]}</p>
      <button
        type="button"
        data-review-close
        class="btn-outline-glow inline-flex h-11 items-center justify-center rounded-DEFAULT border px-8 font-tech text-tech-data uppercase tracking-wider text-[#f4f5f7]"
      >
        {copy.close[locale]}
      </button>
    </div>
  </div>
</div>

<script>
  import { initReviewModal } from '../scripts/review-modal';

  const root = document.getElementById('review-modal');
  if (root) initReviewModal(root);
</script>

---
import { siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
---

<div
  class="fixed inset-x-0 bottom-0 z-[100] md:hidden border-t border-hairline bg-[rgba(12,14,18,0.94)] backdrop-blur-xl px-4 py-3"
>
  <div class="grid grid-cols-2 gap-2">
    <a
      href={siteConfig.phoneHref}
      class="flex items-center justify-center gap-1.5 py-3 rounded-DEFAULT border border-white/15 text-xs font-semibold uppercase tracking-wider text-text-primary hover:border-primary/50 transition"
    >
      {t(locale, 'cta.call')}
    </a>
    <button
      type="button"
      data-open-lead-modal
      data-appliance-prefill={applianceSlug}
      data-appliance-label={applianceLabel}
      class="flex items-center justify-center py-3 rounded-DEFAULT bg-gradient-to-r from-accent-champagne-base to-status-warning text-xs font-semibold uppercase tracking-wider text-surface-base shadow-[0_0_20px_rgba(197,160,89,0.35)]"
    >
      {t(locale, 'cta.requestShort')}
    </button>
  </div>
</div>

---
import CallPhonePicker from './CallPhonePicker.astro';
import type { Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
---

<div
  data-sticky-bar
  class="fixed inset-x-0 bottom-0 z-[100] translate-y-full border-t border-white/10 bg-[#0b0d10]/95 px-2.5 py-2.5 backdrop-blur-md transition-transform duration-300 pointer-events-none md:hidden"
>
  <div class="mx-auto grid max-w-md grid-cols-2 items-center gap-2">
    <CallPhonePicker
      locale={locale}
      placement="top"
      showIcon
      wrapClass="relative min-w-0 w-full"
      fitParent
      buttonClass="h-[38px] w-full gap-1.5 px-2 py-0 text-[13px] leading-none tracking-wide"
    />
    <button
      type="button"
      data-open-lead-modal
      data-sticky-request
      data-appliance-prefill={applianceSlug}
      data-appliance-label={applianceLabel}
      class="btn-lead-glow flex h-[38px] w-full min-w-0 items-center justify-center gap-1.5 rounded-DEFAULT bg-primary-container px-2 text-[13px] font-bold uppercase leading-none tracking-wide text-black active:scale-95"
    >
      <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
      <span class="truncate">{t(locale, 'cta.request')}</span>
    </button>
  </div>
</div>

<script>
  const bar = document.querySelector('[data-sticky-bar]');
  const showAfter = () => Math.max(320, window.innerHeight * 0.65);

  const syncBar = () => {
    if (!bar) return;
    const visible = window.scrollY > showAfter();
    bar.classList.toggle('translate-y-full', !visible);
    bar.classList.toggle('pointer-events-none', !visible);
    bar.toggleAttribute('aria-hidden', !visible);
  };

  syncBar();
  window.addEventListener('scroll', syncBar, { passive: true });
  window.addEventListener('resize', syncBar);

  const button = document.querySelector('[data-sticky-request]');
  button?.addEventListener('click', (event) => {
    const form = document.getElementById('m-form');
    if (!form) return;
    event.preventDefault();
    event.stopPropagation();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

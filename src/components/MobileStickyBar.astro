---
import CallPhonePicker from './CallPhonePicker.astro';
import type { Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
---

<div
  class="fixed inset-x-0 bottom-0 z-[100] md:hidden border-t border-hairline bg-[rgba(12,14,18,0.94)] backdrop-blur-xl px-4 py-3"
>
  <div class="grid grid-cols-2 gap-2">
    <CallPhonePicker
      locale={locale}
      placement="top"
      wrapClass="relative w-full"
      buttonClass="btn-outline-glow flex w-full items-center justify-center gap-1.5 py-3 rounded-DEFAULT border text-xs font-semibold uppercase tracking-wider text-text-primary"
    />
    <button
      type="button"
      data-open-lead-modal
      data-appliance-prefill={applianceSlug}
      data-appliance-label={applianceLabel}
      class="btn-lead-glow flex items-center justify-center py-3 rounded-DEFAULT bg-gradient-to-r from-accent-champagne-base to-status-warning text-xs font-semibold uppercase tracking-wider text-surface-base"
    >
      {t(locale, 'cta.requestShort')}
    </button>
  </div>
</div>

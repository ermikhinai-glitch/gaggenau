---
import { appliances, siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#07080a] pb-24 text-[#8e939d] md:bg-surface-container-lowest md:pb-0">
  <div class="px-4 pb-4 pt-8 md:hidden">
    <div class="mb-6">
      <span class="mb-1.5 block text-[13px] font-bold uppercase tracking-widest text-white">
        {siteConfig.workingTitle[locale]}
      </span>
      <p class="mb-1 text-[13px] leading-relaxed">{t(locale, 'footer.note')}</p>
      <span class="text-[13px]">{t(locale, 'footer.geo')}</span>
    </div>
    <div class="mb-6 grid grid-cols-2 gap-6 text-[13px]">
      <div>
        <span class="mb-3 block text-[13px] font-bold uppercase tracking-wider text-primary">
          {t(locale, 'nav.services')}
        </span>
        <ul class="space-y-2">
          {
            appliances.map((item) => (
              <li>
                <a href={localizePath(locale, item.path)} class="footer-link">
                  {item.label[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <span class="mb-3 block text-[13px] font-bold uppercase tracking-wider text-primary">
          {t(locale, 'nav.contacts')}
        </span>
        <div class="mb-4">
          {
            siteConfig.phones.map((phone) => (
              <a href={phone.href} class="footer-link block font-semibold text-white">
                {phone.display}
              </a>
            ))
          }
          <span class="mt-1 block text-[13px]">{siteConfig.email}</span>
          <span class="block text-[13px] text-[#60646e]">{siteConfig.hours.label[locale]}</span>
        </div>
        <ul class="space-y-2 border-t border-white/5 pt-3">
          <li><a href={localizePath(locale, 'about')} class="footer-link">{t(locale, 'nav.about')}</a></li>
          <li><a href={localizePath(locale, 'warranty')} class="footer-link">{t(locale, 'nav.warranty')}</a></li>
          <li><a href={localizePath(locale, 'parts')} class="footer-link">{t(locale, 'nav.parts')}</a></li>
          <li><a href={localizePath(locale, 'contacts')} class="footer-link">{t(locale, 'nav.contacts')}</a></li>
          <li><a href={localizePath(locale, 'privacy')} class="footer-link">{t(locale, 'nav.privacy')}</a></li>
          <li><a href={localizePath(locale, 'terms')} class="footer-link">{t(locale, 'nav.terms')}</a></li>
        </ul>
      </div>
    </div>
    <div class="flex flex-col gap-1 border-t border-white/5 pt-4 text-[13px] text-[#60646e]">
      <div>© {year} {siteConfig.workingTitle[locale]}</div>
      <div>{t(locale, 'footer.rights')}</div>
    </div>
  </div>

  <div
    class="mx-auto hidden max-w-[1520px] gap-space-xl px-4 py-space-2xl sm:px-6 md:grid md:grid-cols-12 lg:px-10"
  >
    <div class="md:col-span-5 space-y-space-md">
      <p class="text-label-caps text-text-primary">{siteConfig.workingTitle[locale]}</p>
      <p class="text-sm text-text-secondary max-w-md leading-relaxed">
        {t(locale, 'footer.note')}
      </p>
      <p class="text-tech-data text-text-tertiary">{t(locale, 'footer.geo')}</p>
    </div>

    <div class="md:col-span-3 space-y-space-sm">
      <p class="text-label-caps text-primary mb-space-sm">{t(locale, 'nav.services')}</p>
      {
        appliances.map((item) => (
          <a
            href={localizePath(locale, item.path)}
            class="block text-sm text-text-secondary hover:text-primary transition-colors"
          >
            {item.label[locale]}
          </a>
        ))
      }
    </div>

    <div class="md:col-span-4 flex flex-col gap-8">
      <div class="flex flex-col gap-2">
        <p class="text-label-caps text-primary mb-1">{t(locale, 'nav.contacts')}</p>
        <div class="brand-lux-glow grid w-max grid-cols-[max-content_max-content] gap-x-1.5 font-tech text-tech-data tabular-nums">
          {
            siteConfig.phones.map((phone) => (
              <a
                href={phone.href}
                class="col-span-2 grid grid-cols-subgrid whitespace-nowrap text-text-primary hover:text-primary transition-colors"
              >
                <span class="text-right">{phone.prefix}</span>
                <span>{phone.rest}</span>
              </a>
            ))
          }
        </div>
        <a
          href={`mailto:${siteConfig.email}`}
          class="block text-sm text-[#c5cad3] hover:text-primary transition-colors break-all"
        >
          {siteConfig.email}
        </a>
        <p class="text-sm text-text-tertiary">{siteConfig.hours.label[locale]}</p>
      </div>
      <div class="flex flex-col gap-2">
        <a href={localizePath(locale, 'about')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.about')}
        </a>
        <a href={localizePath(locale, 'warranty')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.warranty')}
        </a>
        <a href={localizePath(locale, 'parts')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.parts')}
        </a>
        <a href={localizePath(locale, 'contacts')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.contacts')}
        </a>
        <a href={localizePath(locale, 'privacy')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.privacy')}
        </a>
        <a href={localizePath(locale, 'terms')} class="text-sm text-text-secondary hover:text-primary">
          {t(locale, 'nav.terms')}
        </a>
      </div>
    </div>
  </div>
  <div class="hidden border-t border-hairline md:block">
    <div
      class="mx-auto max-w-[1520px] px-4 sm:px-6 lg:px-10 py-space-md flex flex-wrap justify-between gap-2 text-[11px] text-text-tertiary"
    >
      <span>© {year} {siteConfig.workingTitle[locale]}</span>
      <span>{t(locale, 'footer.rights')}</span>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    text-shadow: 0 0 8px rgba(244, 245, 247, 0.35);
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible,
  .footer-link:active {
    color: #f4f5f7;
    text-shadow:
      0 0 8px rgba(244, 245, 247, 0.7),
      0 0 16px rgba(255, 255, 255, 0.28);
  }
</style>

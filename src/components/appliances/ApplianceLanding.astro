---
import { appliances, type Locale } from '../../config/site';
import type { AppliancePageContent } from '../../content/appliances/types';
import { homeContent } from '../../content/home';
import CallPhonePicker from '../CallPhonePicker.astro';
import PromoBanner from '../PromoBanner.astro';
import { t } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

interface Props {
  locale: Locale;
  page: AppliancePageContent;
}

const { locale, page } = Astro.props;
const label = appliances.find((a) => a.slug === page.slug)?.label[locale] ?? page.slug;
const others = appliances.filter((a) => a.slug !== page.slug);
const process = homeContent.process;
const terms = homeContent.terms;
---

<!-- Hero -->
<section class="relative -mt-20 min-h-[100svh] flex flex-col border-b border-hairline">
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src={page.heroImage}
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[center_30%] contrast-[1.05] motion-hero-bg"
    />
  </div>

  <div
    class="relative z-10 flex min-h-[100svh] w-full max-w-[1520px] mx-auto flex-col justify-between gap-10 px-4 pt-28 pb-8 sm:px-6 sm:pt-32 sm:pb-10 lg:px-10 lg:pt-36 lg:pb-12 motion-fade-up"
  >
    <div class="max-w-3xl">
      <nav class="mb-6 flex flex-wrap items-center gap-2 text-[13px] text-[#c5cad3] lg:mb-8" aria-label="Breadcrumb">
        <a href={localizePath(locale)} class="crumb-link">{locale === 'ru' ? 'Главная' : 'Home'}</a>
        <span class="text-[#8e939d]">/</span>
        <a href={`${localizePath(locale)}#m-appliances`} class="crumb-link md:hidden">
          {locale === 'ru' ? 'Услуги' : 'Services'}
        </a>
        <a href={`${localizePath(locale)}#appliances`} class="crumb-link hidden md:inline">
          {locale === 'ru' ? 'Услуги' : 'Services'}
        </a>
        <span class="text-[#8e939d]">/</span>
        <span class="text-[#f4f5f7]">{label}</span>
      </nav>
      <h1 class="text-display-hero max-lg:!text-[20px] max-lg:!leading-[1.15] text-text-primary uppercase mb-space-md">
        {page.title[locale]}
        <span class="text-primary"> {page.titleAccent[locale]}</span>
      </h1>
      <p
        class="mb-space-xl max-w-xl rounded-DEFAULT border border-white/10 bg-[#0c0e12]/50 px-5 py-4 text-base leading-relaxed text-[#e8eaef] backdrop-blur-md sm:text-lg"
      >
        {page.subtitle[locale]}
      </p>
      <div class="grid max-w-xl grid-cols-2 gap-2">
        <button
          type="button"
          data-open-lead-modal
          data-appliance-prefill={page.slug}
          data-appliance-label={label}
          class="btn-lead-glow inline-flex h-12 w-full items-center justify-center rounded-DEFAULT bg-primary-container px-4 text-sm font-semibold uppercase leading-none tracking-wider text-on-primary-container"
        >
          {t(locale, 'cta.request')}
        </button>
        <CallPhonePicker
          locale={locale}
          fitParent
          wrapClass="relative min-w-0 w-full"
          buttonClass="h-12 w-full px-4"
        />
      </div>
    </div>
    <div class="grid max-w-xl grid-cols-2 items-stretch gap-2">
      <div class="surface-lux-glow flex h-full min-w-0 flex-col rounded-DEFAULT border bg-surface-raised/85 px-2 py-2.5 backdrop-blur-md">
        <div class="whitespace-nowrap text-tech-data-lg text-primary max-sm:!text-[18px] max-sm:!leading-none">{homeContent.sla[0].value[locale]}</div>
        <p class="mt-1 text-[13px] leading-snug text-text-secondary">{t(locale, 'sla.callback')}</p>
      </div>
      <div class="surface-lux-glow flex h-full min-w-0 flex-col rounded-DEFAULT border bg-surface-raised/85 px-2 py-2.5 backdrop-blur-md">
        <div class="whitespace-nowrap text-tech-data-lg text-primary max-sm:!text-[18px] max-sm:!leading-none">{homeContent.sla[1].value[locale]}</div>
        <p class="mt-1 text-[13px] leading-snug text-text-secondary">{t(locale, 'sla.visit')}</p>
      </div>
    </div>
  </div>
</section>

<!-- Faults -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{page.faultsTitle[locale]}</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {
        page.faults.map((fault) => (
          <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
            <h3 class="font-display text-lg text-text-primary mb-2">{fault.title[locale]}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{fault.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Process -->
<section class="py-space-2xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{process.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{process.title[locale]}</h2>
    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        process.steps.map((step) => (
          <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
            <div class="text-tech-data-lg text-primary mb-2">{step.n}</div>
            <h3 class="font-display text-base text-text-primary mb-2">{step.title[locale]}</h3>
            <p class="text-sm text-text-secondary">{step.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Terms -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{terms.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{terms.title[locale]}</h2>
    <p class="surface-lux-glow max-w-3xl text-text-secondary leading-relaxed border rounded-DEFAULT p-space-lg bg-surface-raised/60">
      {terms.body[locale]}
    </p>
  </div>
</section>

<PromoBanner locale={locale} applianceSlug={page.slug} applianceLabel={label} />

<!-- Warranty -->
<section class="py-space-2xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{locale === 'ru' ? 'Гарантия' : 'Warranty'}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">
      {locale === 'ru' ? 'Гарантия на работы и запчасти' : 'Labour and parts warranty'}
    </h2>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Работы — 12 месяцев' : 'Labour — 12 months'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Фиксированный срок на выполненные работы.' : 'Fixed term on completed labour.'}
        </p>
      </div>
      <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Запчасти — производитель' : 'Parts — manufacturer'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Гарантия производителя запчасти.' : 'Manufacturer warranty on parts.'}
        </p>
      </div>
      <div class="surface-lux-glow rounded-DEFAULT border bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Только оригинал' : 'Original only'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Устанавливаем оригинальные комплектующие.' : 'We install original components.'}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]" id="faq">
  <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{page.faqTitle[locale]}</h2>
    <div class="space-y-3">
      {
        page.faq.map((item) => (
          <details class="surface-lux-glow group rounded-DEFAULT border bg-surface-raised">
            <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4 font-display text-base text-text-primary">
              <span>{item.q[locale]}</span>
              <span class="text-primary transition group-open:rotate-180">▾</span>
            </summary>
            <div class="px-5 pb-5 text-sm text-text-secondary leading-relaxed">{item.a[locale]}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-space-2xl border-t border-hairline text-center">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-4">
      {locale === 'ru' ? `Нужен ремонт: ${label}?` : `Need repair: ${label}?`}
    </h2>
    <p class="text-text-secondary mb-space-xl max-w-xl mx-auto">
      {
        locale === 'ru'
          ? 'Оставьте заявку — тип техники уже будет учтён. Или позвоните.'
          : 'Leave a request — appliance type will be preselected. Or call.'
      }
    </p>
    <div class="mx-auto grid w-full max-w-xl grid-cols-1 gap-3 sm:grid-cols-2">
      <button
        type="button"
        data-open-lead-modal
        data-appliance-prefill={page.slug}
        data-appliance-label={label}
        class="btn-lead-glow inline-flex h-12 w-full items-center justify-center rounded-DEFAULT bg-primary-container px-4 text-sm font-semibold uppercase tracking-wider text-on-primary-container"
      >
        {t(locale, 'cta.request')}
      </button>
      <CallPhonePicker
        locale={locale}
        fitParent
        wrapClass="relative min-w-0 w-full"
        buttonClass="h-12 w-full px-4"
      />
    </div>
  </div>
</section>

<!-- Other types -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">
      {locale === 'ru' ? 'Другая техника Gaggenau' : 'Other Gaggenau appliances'}
    </h2>
    <div class="flex flex-wrap gap-3">
      {
        others.map((item) => (
          <a
            href={localizePath(locale, item.path)}
            class="surface-lux-glow inline-flex items-center rounded-DEFAULT border bg-surface-raised px-4 py-3 text-sm text-text-secondary hover:text-primary"
          >
            {item.label[locale]}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .crumb-link {
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .crumb-link:hover,
  .crumb-link:focus-visible,
  .crumb-link:active {
    color: #f4f5f7;
    text-shadow:
      0 0 8px rgba(244, 245, 247, 0.7),
      0 0 16px rgba(255, 255, 255, 0.28);
  }
</style>

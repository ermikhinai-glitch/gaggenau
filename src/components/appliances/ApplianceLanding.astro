---
import { appliances, siteConfig, type Locale } from '../../config/site';
import type { AppliancePageContent } from '../../content/appliances/types';
import { homeContent } from '../../content/home';
import PromoBanner from '../PromoBanner.astro';
import { t } from '../../i18n/ui';
import { localizePath } from '../../i18n/utils';

interface Props {
  locale: Locale;
  page: AppliancePageContent;
}

const { locale, page } = Astro.props;
const label = appliances.find((a) => a.slug === page.slug)?.label[locale] ?? page.slug;
const others = appliances.filter((a) => a.slug !== page.slug);
const process = homeContent.process;
const terms = homeContent.terms;
---

<!-- Breadcrumbs -->
<div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 pt-space-md pb-space-xs">
  <nav class="flex flex-wrap items-center gap-2 text-[11px] text-text-tertiary" aria-label="Breadcrumb">
    <a href={localizePath(locale)} class="hover:text-primary transition-colors">{locale === 'ru' ? 'Главная' : 'Home'}</a>
    <span class="opacity-40">/</span>
    <a href={`${localizePath(locale)}#appliances`} class="hover:text-primary transition-colors">
      {locale === 'ru' ? 'Услуги' : 'Services'}
    </a>
    <span class="opacity-40">/</span>
    <span class="text-text-secondary">{label}</span>
  </nav>
</div>

<!-- Hero -->
<section class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 pt-space-md pb-space-2xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">
    <div class="lg:col-span-7 motion-fade-up">
      <div
        class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-surface-raised border border-hairline mb-space-md"
      >
        <span class="w-2 h-2 rounded-full bg-status-active"></span>
        <span class="text-label-caps text-text-secondary tracking-[0.12em]">{page.badge[locale]}</span>
      </div>
      <h1 class="text-display-hero text-text-primary uppercase mb-space-md">
        {page.title[locale]}
        <span class="text-primary"> {page.titleAccent[locale]}</span>
      </h1>
      <p class="max-w-2xl text-base sm:text-lg text-text-secondary leading-relaxed mb-space-xl">
        {page.subtitle[locale]}
      </p>
      <div class="flex flex-wrap gap-space-md mb-space-lg">
        <button
          type="button"
          data-open-lead-modal
          data-appliance-prefill={page.slug}
          data-appliance-label={label}
          class="inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container shadow-[0_0_24px_rgba(197,160,89,0.3)]"
        >
          {t(locale, 'cta.request')}
        </button>
        <a
          href={siteConfig.phoneHref}
          class="inline-flex h-12 items-center justify-center rounded-DEFAULT border border-white/15 px-6 font-tech text-tech-data uppercase tracking-wider text-text-primary hover:border-primary transition"
        >
          {t(locale, 'cta.call')} · {siteConfig.phoneDisplay}
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl">
        <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-4">
          <div class="text-tech-data-lg text-primary">15 мин</div>
          <p class="text-xs text-text-secondary mt-1">{t(locale, 'sla.callback')}</p>
        </div>
        <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-4">
          <div class="text-tech-data-lg text-primary">от 30 мин</div>
          <p class="text-xs text-text-secondary mt-1">{t(locale, 'sla.visit')}</p>
        </div>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="relative aspect-[4/5] overflow-hidden rounded-lg border border-hairline bg-surface-raised">
        <img
          src={page.heroImage}
          alt={label}
          width="900"
          height="1125"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-surface-base via-transparent to-transparent"></div>
      </div>
    </div>
  </div>
</section>

<!-- Faults -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{page.faultsTitle[locale]}</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {
        page.faults.map((fault) => (
          <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
            <h3 class="font-display text-lg text-text-primary mb-2">{fault.title[locale]}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{fault.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Process -->
<section class="py-space-2xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{process.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{process.title[locale]}</h2>
    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
      {
        process.steps.map((step) => (
          <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
            <div class="text-tech-data-lg text-primary mb-2">{step.n}</div>
            <h3 class="font-display text-base text-text-primary mb-2">{step.title[locale]}</h3>
            <p class="text-sm text-text-secondary">{step.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Terms -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{terms.eyebrow[locale]}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-md">{terms.title[locale]}</h2>
    <p class="max-w-3xl text-text-secondary leading-relaxed border border-border-metallic/40 rounded-DEFAULT p-space-lg bg-surface-raised/60">
      {terms.body[locale]}
    </p>
  </div>
</section>

<PromoBanner locale={locale} applianceSlug={page.slug} applianceLabel={label} />

<!-- Warranty -->
<section class="py-space-2xl border-t border-hairline">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <p class="text-label-caps text-primary mb-2">{locale === 'ru' ? 'Гарантия' : 'Warranty'}</p>
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">
      {locale === 'ru' ? 'Гарантия на работы и запчасти' : 'Labour and parts warranty'}
    </h2>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Работы — 12 месяцев' : 'Labour — 12 months'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Фиксированный срок на выполненные работы.' : 'Fixed term on completed labour.'}
        </p>
      </div>
      <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Запчасти — производитель' : 'Parts — manufacturer'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Гарантия производителя запчасти.' : 'Manufacturer warranty on parts.'}
        </p>
      </div>
      <div class="rounded-DEFAULT border border-hairline bg-surface-raised p-space-lg">
        <h3 class="font-display text-base text-text-primary mb-1">
          {locale === 'ru' ? 'Только оригинал' : 'Original only'}
        </h3>
        <p class="text-sm text-text-secondary">
          {locale === 'ru' ? 'Устанавливаем оригинальные комплектующие.' : 'We install original components.'}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]" id="faq">
  <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-xl">{page.faqTitle[locale]}</h2>
    <div class="space-y-3">
      {
        page.faq.map((item) => (
          <details class="group rounded-DEFAULT border border-hairline bg-surface-raised open:border-border-metallic">
            <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4 font-display text-base text-text-primary">
              <span>{item.q[locale]}</span>
              <span class="text-primary transition group-open:rotate-180">▾</span>
            </summary>
            <div class="px-5 pb-5 text-sm text-text-secondary leading-relaxed">{item.a[locale]}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-space-2xl border-t border-hairline text-center">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-4">
      {locale === 'ru' ? `Нужен ремонт: ${label}?` : `Need repair: ${label}?`}
    </h2>
    <p class="text-text-secondary mb-space-xl max-w-xl mx-auto">
      {
        locale === 'ru'
          ? 'Оставьте заявку — тип техники уже будет учтён. Или позвоните.'
          : 'Leave a request — appliance type will be preselected. Or call.'
      }
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button
        type="button"
        data-open-lead-modal
        data-appliance-prefill={page.slug}
        data-appliance-label={label}
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT bg-primary-container px-8 text-sm font-semibold uppercase tracking-wider text-on-primary-container"
      >
        {t(locale, 'cta.request')}
      </button>
      <a
        href={siteConfig.phoneHref}
        class="inline-flex h-12 items-center justify-center rounded-DEFAULT border border-white/20 px-8 font-tech text-tech-data uppercase tracking-wider"
      >
        {t(locale, 'cta.call')}
      </a>
    </div>
  </div>
</section>

<!-- Other types -->
<section class="py-space-2xl border-t border-hairline bg-[#0e1015]">
  <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10">
    <h2 class="text-headline-lg text-text-primary uppercase mb-space-lg">
      {locale === 'ru' ? 'Другая техника Gaggenau' : 'Other Gaggenau appliances'}
    </h2>
    <div class="flex flex-wrap gap-3">
      {
        others.map((item) => (
          <a
            href={localizePath(locale, item.path)}
            class="inline-flex items-center rounded-DEFAULT border border-hairline bg-surface-raised px-4 py-3 text-sm text-text-secondary hover:text-primary hover:border-border-metallic transition"
          >
            {item.label[locale]}
          </a>
        ))
      }
    </div>
  </div>
</section>

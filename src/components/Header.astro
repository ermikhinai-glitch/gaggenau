---
import CallPhonePicker from './CallPhonePicker.astro';
import { appliances, siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localizePath, switchLocalePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
const pathname = Astro.url.pathname;
const ruHref = switchLocalePath(pathname, 'ru');
const enHref = switchLocalePath(pathname, 'en');
const headerPhone = siteConfig.phones[1];
const brandKicker = locale === 'ru' ? 'Официальный сервис' : 'Official service';
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-white/10 bg-[rgba(12,14,18,0.95)] backdrop-blur-xl"
>
  <div class="md:hidden" data-mobile-header>
    <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center pr-[max(0.75rem,env(safe-area-inset-right))]">
      <span class="col-start-1 row-start-1 flex min-w-0 items-center gap-1.5 self-stretch border-b border-white/[0.06] py-1.5 pl-[max(0.5rem,env(safe-area-inset-left))] font-tech text-[11px] font-medium uppercase leading-none tracking-tight text-[#f4f5f7] min-[360px]:text-[12px] min-[360px]:tracking-normal">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_8px_#4ade80]"></span>
        <span class="whitespace-nowrap">{siteConfig.hours.label[locale]}</span>
      </span>
      <div class="col-span-2 col-start-2 row-start-1 flex items-center justify-end gap-1.5 self-stretch border-b border-white/[0.06] py-1.5">
        <div class="flex items-center gap-1 font-tech text-[11px] font-bold leading-none">
          <a href={ruHref} hreflang="ru" class:list={['uppercase', locale === 'ru' ? 'text-primary' : 'text-white/60']}>
            {t(locale, 'lang.ru')}
          </a>
          <span class="text-white/30" aria-hidden="true">|</span>
          <a href={enHref} hreflang="en" class:list={['uppercase', locale === 'en' ? 'text-primary' : 'text-white/60']}>
            {t(locale, 'lang.en')}
          </a>
        </div>
        <a href={headerPhone.href} class="font-tech text-[11px] font-semibold leading-none tracking-normal whitespace-nowrap text-white tabular-nums">
          {headerPhone.display}
        </a>
      </div>

      <a href={localizePath(locale)} class="col-start-1 row-start-2 min-w-0 py-2 pl-[max(0.75rem,env(safe-area-inset-left))]">
        <span class="block text-[11px] font-bold uppercase leading-none tracking-[0.12em] text-white">
          {brandKicker}
        </span>
        <span class="mt-1 block font-[family-name:var(--font-brand)] text-[15px] font-extrabold uppercase leading-none tracking-[0.14em] text-primary">
          Gaggenau
        </span>
        <span class="mt-1 block text-[11px] leading-none text-[#8e939d]">
          {siteConfig.geo[locale]}
        </span>
      </a>
      <CallPhonePicker
        locale={locale}
        iconOnly
        placement="bottom"
        wrapClass="relative col-start-2 row-start-2 inline-flex shrink-0 justify-self-start self-center pr-1"
      />
      <button
        type="button"
        data-open-lead-modal
        data-appliance-prefill={applianceSlug}
        data-appliance-label={applianceLabel}
        class="btn-lead-glow col-start-3 row-start-2 inline-flex h-9 justify-self-start items-center justify-center whitespace-nowrap rounded-DEFAULT bg-primary-container px-1.5 text-[10px] font-bold uppercase leading-none tracking-wide text-black min-[360px]:px-3 min-[360px]:text-[11px]"
      >
        {t(locale, 'cta.request')}
      </button>
    </div>

    <nav
      class="flex items-center justify-between gap-2 border-t border-white/[0.06] py-2 pl-[max(0.75rem,env(safe-area-inset-left))] pr-[max(0.75rem,env(safe-area-inset-right))] text-[13px] text-[#d7dbe3]"
      aria-label={locale === 'ru' ? 'Основное меню' : 'Main'}
    >
      <button type="button" data-mobile-menu-toggle class="mobile-nav-link flex items-center gap-1 whitespace-nowrap" aria-expanded="false" aria-controls="mobile-menu-panel">
        {t(locale, 'nav.services')}
        <span class="text-[12px] text-primary" aria-hidden="true">▾</span>
      </button>
      <a href={localizePath(locale, 'about')} class="mobile-nav-link whitespace-nowrap">{t(locale, 'nav.about')}</a>
      <a href={localizePath(locale, 'warranty')} class="mobile-nav-link whitespace-nowrap">{t(locale, 'nav.warranty')}</a>
      <a href={localizePath(locale, 'contacts')} class="mobile-nav-link whitespace-nowrap">{t(locale, 'nav.contacts')}</a>
    </nav>

    <div id="mobile-menu-panel" data-mobile-menu-panel hidden class="border-t border-white/10 bg-[#12151b] px-3 py-2">
      {
        appliances.map((item) => (
          <a
            href={localizePath(locale, item.path)}
            class="mobile-appliance-link block px-1 py-2 text-[13px] text-[#c5cad3]"
          >
            {item.label[locale]}
          </a>
        ))
      }
    </div>
  </div>

  <div
    class="mx-auto hidden h-20 max-w-[1520px] items-center justify-between gap-space-md px-4 sm:px-6 lg:px-10 md:flex"
  >
    <a href={localizePath(locale)} class="brand-lux-glow flex min-w-0 flex-col">
      <span class="font-tech text-[13px] sm:text-[14px] font-semibold uppercase tracking-[0.12em] text-text-primary truncate">
        {siteConfig.workingTitle[locale]}
      </span>
      <span class="hidden sm:block font-body text-[12px] text-[#c5cad3]">
        {siteConfig.geo[locale]}
      </span>
    </a>

    <nav class="hidden xl:flex items-center gap-7 text-[15px] font-medium tracking-wide" aria-label={locale === 'ru' ? 'Основное меню' : 'Main'}>
      <div class="relative group py-2">
        <button
          type="button"
          class="flex items-center gap-1 text-[#d7dbe3] hover:text-primary transition-colors"
          aria-haspopup="true"
        >
          {t(locale, 'nav.services')}
          <span class="text-primary text-sm" aria-hidden="true">▾</span>
        </button>
        <div
          class="absolute left-0 top-full z-50 hidden group-hover:flex group-focus-within:flex flex-col w-64 p-2 rounded-DEFAULT border border-hairline bg-surface-raised/95 backdrop-blur-xl shadow-[0_20px_40px_rgba(0,0,0,0.8)]"
        >
          {
            appliances.map((item) => (
              <a
                href={localizePath(locale, item.path)}
                class="px-3 py-2 text-sm text-[#c5cad3] hover:text-primary hover:bg-white/5 rounded-DEFAULT transition-colors"
              >
                {item.label[locale]}
              </a>
            ))
          }
        </div>
      </div>
      <a
        href={localizePath(locale, 'about')}
        class="text-[#d7dbe3] hover:text-primary transition-colors"
      >
        {t(locale, 'nav.about')}
      </a>
      <a
        href={localizePath(locale, 'warranty')}
        class="text-[#d7dbe3] hover:text-primary transition-colors"
      >
        {t(locale, 'nav.warranty')}
      </a>
      <a
        href={localizePath(locale, 'contacts')}
        class="text-[#d7dbe3] hover:text-primary transition-colors"
      >
        {t(locale, 'nav.contacts')}
      </a>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      <div class="hidden md:flex flex-col items-start">
        <span class="flex items-center gap-1.5 mb-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-status-active shadow-[0_0_8px_#4ade80]"></span>
          <span class="font-tech text-[12px] tracking-wider text-[#c5cad3] uppercase">
            {siteConfig.hours.label[locale]}
          </span>
        </span>
        <a
          href={headerPhone.href}
          class="brand-lux-glow font-tech text-[17px] font-semibold tracking-wide text-text-primary hover:text-primary transition-colors tabular-nums"
        >
          {headerPhone.display}
        </a>
      </div>

      <div
        class="surface-lux-glow hidden sm:flex items-center rounded-full border bg-surface-container p-0.5 font-tech text-[11px] font-bold"
      >
        <a
          href={ruHref}
          hreflang="ru"
          class:list={[
            'px-2.5 py-0.5 rounded-full uppercase transition',
            locale === 'ru'
              ? 'bg-primary-container text-on-primary-container'
              : 'text-[#c5cad3] hover:text-text-primary',
          ]}
        >
          {t(locale, 'lang.ru')}
        </a>
        <a
          href={enHref}
          hreflang="en"
          class:list={[
            'px-2.5 py-0.5 rounded-full uppercase transition',
            locale === 'en'
              ? 'bg-primary-container text-on-primary-container'
              : 'text-[#c5cad3] hover:text-text-primary',
          ]}
        >
          {t(locale, 'lang.en')}
        </a>
      </div>

      <button
        type="button"
        data-open-lead-modal
        data-appliance-prefill={applianceSlug}
        data-appliance-label={applianceLabel}
        class="btn-lead-glow inline-flex h-11 items-center justify-center rounded-DEFAULT bg-primary-container px-4 text-[14px] font-semibold uppercase tracking-wider text-on-primary-container active:scale-[0.98] lg:hidden"
      >
        {t(locale, 'cta.request')}
      </button>
      <div class="hidden lg:grid grid-cols-2 gap-2">
        <CallPhonePicker
          locale={locale}
          placement="bottom"
          fitParent
          wrapClass="relative min-w-0 w-full"
          buttonClass="h-11 w-full px-4"
        />
        <button
          type="button"
          data-open-lead-modal
          data-appliance-prefill={applianceSlug}
          data-appliance-label={applianceLabel}
          class="btn-lead-glow inline-flex h-11 w-full items-center justify-center rounded-DEFAULT bg-primary-container px-4 text-[14px] font-semibold uppercase tracking-wider text-on-primary-container active:scale-[0.98]"
        >
          {t(locale, 'cta.request')}
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-nav-link {
    text-shadow: 0 0 8px rgba(244, 245, 247, 0.35);
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .mobile-appliance-link {
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible,
  .mobile-nav-link:active,
  .mobile-appliance-link:hover,
  .mobile-appliance-link:focus-visible,
  .mobile-appliance-link:active {
    color: #f4f5f7;
    text-shadow:
      0 0 8px rgba(244, 245, 247, 0.7),
      0 0 16px rgba(255, 255, 255, 0.28);
  }
</style>

<script>
  const siteHeader = document.querySelector('header');
  const syncHeaderSpace = () => {
    if (!siteHeader || window.innerWidth >= 768) return;
    const menuPanel = siteHeader.querySelector('[data-mobile-menu-panel]');
    let height = siteHeader.getBoundingClientRect().height;
    if (menuPanel && !menuPanel.hidden) height -= menuPanel.getBoundingClientRect().height;
    document.documentElement.style.setProperty('--site-header', `${Math.ceil(height)}px`);
  };
  syncHeaderSpace();
  window.addEventListener('resize', syncHeaderSpace);

  const mobileHeader = document.querySelector('[data-mobile-header]');
  if (mobileHeader) {
    const menuPanel = mobileHeader.querySelector('[data-mobile-menu-panel]');
    const menuToggles = mobileHeader.querySelectorAll('[data-mobile-menu-toggle]');
    const setMenuOpen = (open) => {
      menuPanel.hidden = !open;
      menuToggles.forEach((button) => button.setAttribute('aria-expanded', open ? 'true' : 'false'));
    };
    menuToggles.forEach((button) => {
      button.addEventListener('click', () => setMenuOpen(menuPanel.hidden));
    });
    document.addEventListener('click', (event) => {
      if (!mobileHeader.contains(event.target)) setMenuOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
  }
</script>

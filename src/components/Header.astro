---
import { appliances, siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localizePath, switchLocalePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  applianceSlug?: string;
  applianceLabel?: string;
}

const { locale, applianceSlug, applianceLabel } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHere = (path: string) => pathname === localizePath(locale, path).replace(/\/$/, '');
const ruHref = switchLocalePath(pathname, 'ru');
const enHref = switchLocalePath(pathname, 'en');
const headerPhone = siteConfig.phones[1];
const otherLocaleHref = locale === 'ru' ? enHref : ruHref;
const otherLocale = locale === 'ru' ? 'en' : 'ru';
const langToggleLabel =
  locale === 'ru' ? 'Switch to English' : 'Переключить на русский';
---

<header
  class="fixed top-0 inset-x-0 z-50 border-b border-white/10 bg-[rgba(12,14,18,0.95)] backdrop-blur-xl"
  data-site-header
>
  <!-- Mobile: one row — brand · phone · menu -->
  <div class="md:hidden" data-mobile-header>
    <div
      class="flex h-14 items-center justify-between gap-3 px-[max(0.75rem,env(safe-area-inset-left))] pr-[max(0.75rem,env(safe-area-inset-right))] text-[#f4f5f7]"
    >
      <a href={localizePath(locale)} class="min-w-0 shrink">
        <span class="text-brand-mark block truncate text-[17px] leading-none text-primary">Gaggenau</span>
        <span class="mt-px block truncate text-[10px] font-medium uppercase leading-none tracking-[0.06em] text-white/55">
          {locale === 'ru' ? 'Официальный сервис' : 'Official service'}
        </span>
      </a>
      <div class="flex shrink-0 items-center gap-2.5">
        <a
          href={headerPhone.href}
          class="font-tech text-[13px] font-medium tabular-nums tracking-wide text-[#d7dbe3] hover:text-primary"
        >
          {headerPhone.display}
        </a>
        <button
          type="button"
          data-mobile-menu-toggle
          class="inline-flex h-9 w-9 items-center justify-center rounded-DEFAULT border border-primary/50 bg-[#181b22]/65 text-primary"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label={locale === 'ru' ? 'Меню' : 'Menu'}
        >
          <svg class="menu-icon-bars h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="menu-icon-close h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu-panel" data-mobile-menu-panel hidden class="border-t border-white/10 bg-[#12151b] px-4 pb-4 pt-3.5">
      <div class="mb-3 flex items-center justify-between gap-3 border-b border-white/10 pb-3">
        <span class="flex min-w-0 items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-[#c5cad3]">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"></span>
          <span class="truncate">{siteConfig.hours.label[locale]}</span>
        </span>
        <a
          href={otherLocaleHref}
          hreflang={otherLocale}
          lang={otherLocale}
          aria-label={langToggleLabel}
          title={langToggleLabel}
          class="surface-lux-glow flex shrink-0 items-center rounded-full border bg-surface-container p-0.5 font-tech text-[11px] font-bold transition hover:border-primary/40"
        >
          <span
            class:list={[
              'rounded-full px-2.5 py-0.5 uppercase transition',
              locale === 'ru'
                ? 'bg-primary-container text-on-primary-container'
                : 'text-[#c5cad3]',
            ]}
            aria-hidden="true"
          >
            {t(locale, 'lang.ru')}
          </span>
          <span
            class:list={[
              'rounded-full px-2.5 py-0.5 uppercase transition',
              locale === 'en'
                ? 'bg-primary-container text-on-primary-container'
                : 'text-[#c5cad3]',
            ]}
            aria-hidden="true"
          >
            {t(locale, 'lang.en')}
          </span>
        </a>
      </div>

      <nav class="flex flex-col gap-0.5" aria-label={locale === 'ru' ? 'Мобильное меню' : 'Mobile menu'}>
        <div data-mobile-submenu>
          <button
            type="button"
            data-mobile-submenu-toggle
            class="mobile-nav-link flex w-full items-center justify-between gap-2 rounded-DEFAULT px-1 py-2.5 text-left text-[13px] font-medium text-[#f4f5f7]"
            aria-expanded="false"
            aria-controls="mobile-services-submenu"
          >
            <span>{t(locale, 'nav.services')}</span>
            <span data-mobile-submenu-chevron class="text-primary transition-transform duration-200" aria-hidden="true">▾</span>
          </button>
          <div
            id="mobile-services-submenu"
            data-mobile-submenu-panel
            hidden
            class="mb-1 border-b border-white/10 pb-2"
          >
            <div class="grid grid-cols-2 gap-x-2 gap-y-0.5">
              {
                appliances.map((item) => (
                  <a
                    href={localizePath(locale, item.path)}
                    class:list={[
                      'mobile-appliance-link block rounded-DEFAULT px-1.5 py-2 text-[12px] font-medium leading-snug',
                      isHere(item.path) ? 'text-primary' : 'text-[#c5cad3]',
                    ]}
                  >
                    {item.label[locale]}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        <a href={localizePath(locale, 'about')} class:list={['mobile-nav-link block rounded-DEFAULT px-1 py-2.5 text-[13px] font-medium', isHere('about') ? 'text-primary' : 'text-[#f4f5f7]']}>{t(locale, 'nav.about')}</a>
        <a href={localizePath(locale, 'warranty')} class:list={['mobile-nav-link block rounded-DEFAULT px-1 py-2.5 text-[13px] font-medium', isHere('warranty') ? 'text-primary' : 'text-[#f4f5f7]']}>{t(locale, 'nav.warranty')}</a>
        <a href={localizePath(locale, 'parts')} class:list={['mobile-nav-link block rounded-DEFAULT px-1 py-2.5 text-[13px] font-medium', isHere('parts') ? 'text-primary' : 'text-[#f4f5f7]']}>{t(locale, 'nav.parts')}</a>
        <a href={localizePath(locale, 'contacts')} class:list={['mobile-nav-link block rounded-DEFAULT px-1 py-2.5 text-[13px] font-medium', isHere('contacts') ? 'text-primary' : 'text-[#f4f5f7]']}>{t(locale, 'nav.contacts')}</a>
      </nav>

      <button
        type="button"
        data-open-lead-modal
        data-appliance-prefill={applianceSlug}
        data-appliance-label={applianceLabel}
        class="btn-lead-glow mt-4 inline-flex h-11 w-full items-center justify-center rounded-DEFAULT bg-primary-container text-[13px] font-semibold uppercase tracking-wide text-black"
      >
        {t(locale, 'cta.request')}
      </button>
    </div>
  </div>

  <!-- Desktop / tablet: utility strip + main bar -->
  <div class="hidden md:block" data-desktop-header>
    <div data-header-utility class="header-utility border-b border-white/10">
      <div
        class="mx-auto flex h-9 max-w-[1520px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-10"
      >
        <span class="flex min-w-0 items-center gap-1.5">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-status-active shadow-[0_0_8px_#4ade80]"></span>
          <span class="font-tech truncate text-[11px] uppercase tracking-wider text-[#c5cad3]">
            {siteConfig.hours.label[locale]}
          </span>
        </span>
        <div class="flex shrink-0 items-center gap-4">
          <a
            href={headerPhone.href}
            class="brand-lux-glow font-tech text-[14px] font-semibold tracking-wide text-text-primary tabular-nums transition-colors hover:text-primary"
          >
            {headerPhone.display}
          </a>
          <a
            href={otherLocaleHref}
            hreflang={otherLocale}
            lang={otherLocale}
            aria-label={langToggleLabel}
            title={langToggleLabel}
            class="surface-lux-glow flex items-center rounded-full border bg-surface-container p-0.5 font-tech text-[11px] font-bold transition hover:border-primary/40"
          >
            <span
              class:list={[
                'rounded-full px-2.5 py-0.5 uppercase transition',
                locale === 'ru'
                  ? 'bg-primary-container text-on-primary-container'
                  : 'text-[#c5cad3]',
              ]}
              aria-hidden="true"
            >
              {t(locale, 'lang.ru')}
            </span>
            <span
              class:list={[
                'rounded-full px-2.5 py-0.5 uppercase transition',
                locale === 'en'
                  ? 'bg-primary-container text-on-primary-container'
                  : 'text-[#c5cad3]',
              ]}
              aria-hidden="true"
            >
              {t(locale, 'lang.en')}
            </span>
          </a>
        </div>
      </div>
    </div>

    <div
      data-header-main
      class="mx-auto flex h-16 max-w-[1520px] items-center justify-between gap-4 px-4 sm:px-6 lg:gap-6 lg:px-10"
    >
      <div class="flex min-w-0 items-center gap-5 lg:gap-8">
        <a href={localizePath(locale)} class="brand-lux-glow flex min-w-0 shrink flex-col">
          <span class="font-tech text-[13px] font-semibold uppercase tracking-[0.1em] text-text-primary lg:text-[14px] lg:tracking-[0.12em]">
            {siteConfig.workingTitle[locale]}
          </span>
          <span class="hidden font-body text-[12px] text-[#c5cad3] lg:block">
            {siteConfig.geo[locale]}
          </span>
        </a>

        <nav
          class="flex items-center gap-3.5 whitespace-nowrap text-[13px] font-medium tracking-wide lg:gap-6 lg:text-[14px]"
          aria-label={locale === 'ru' ? 'Основное меню' : 'Main'}
        >
          <div class="relative group py-2">
            <button
              type="button"
              class="flex items-center gap-1 text-[#d7dbe3] transition-colors hover:text-primary"
              aria-haspopup="true"
            >
              {t(locale, 'nav.services')}
              <span class="text-sm text-primary" aria-hidden="true">▾</span>
            </button>
            <div
              class="absolute left-0 top-full z-50 hidden w-64 flex-col rounded-DEFAULT border border-hairline bg-surface-raised/95 p-2 shadow-[0_20px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl group-hover:flex group-focus-within:flex"
            >
              {
                appliances.map((item) => (
                  <a
                    href={localizePath(locale, item.path)}
                    class="rounded-DEFAULT px-3 py-2 text-sm text-[#c5cad3] transition-colors hover:bg-white/5 hover:text-primary"
                  >
                    {item.label[locale]}
                  </a>
                ))
              }
            </div>
          </div>
          <a href={localizePath(locale, 'about')} class="text-[#d7dbe3] transition-colors hover:text-primary">
            {t(locale, 'nav.about')}
          </a>
          <a href={localizePath(locale, 'warranty')} class="text-[#d7dbe3] transition-colors hover:text-primary">
            {t(locale, 'nav.warranty')}
          </a>
          <a href={localizePath(locale, 'parts')} class="text-[#d7dbe3] transition-colors hover:text-primary">
            {t(locale, 'nav.parts')}
          </a>
          <a href={localizePath(locale, 'contacts')} class="text-[#d7dbe3] transition-colors hover:text-primary">
            {t(locale, 'nav.contacts')}
          </a>
        </nav>
      </div>

      <div class="flex shrink-0 items-center gap-2.5 lg:gap-4">
        <!-- Compact scroll: icon call (saves space on laptop) -->
        <a
          href={headerPhone.href}
          data-header-scroll-phone
          class="header-scroll-phone-icon btn-outline-glow hidden h-10 w-10 items-center justify-center rounded-DEFAULT border border-primary/50 bg-[#181b22]/65 text-primary"
          aria-label={t(locale, 'cta.call')}
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>
        <button
          type="button"
          data-open-lead-modal
          data-appliance-prefill={applianceSlug}
          data-appliance-label={applianceLabel}
          class="btn-lead-glow inline-flex h-11 shrink-0 items-center justify-center rounded-DEFAULT bg-primary-container px-4 text-[13px] font-semibold uppercase tracking-wider text-on-primary-container active:scale-[0.98] lg:px-5 lg:text-[14px]"
        >
          {t(locale, 'cta.request')}
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  :global([data-site-header]) {
    transition: transform 0.25s ease;
  }

  /* Slide utility off-screen; padding is synced to main-bar height (no air gap) */
  :global([data-site-header].is-compact) {
    transform: translateY(calc(-1 * var(--header-utility-h, 2.25rem)));
  }

  :global([data-site-header].is-compact) [data-header-utility] {
    pointer-events: none;
  }

  :global([data-site-header].is-compact) .header-scroll-phone-icon {
    display: inline-flex;
  }

  .mobile-nav-link,
  .mobile-appliance-link {
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible,
  .mobile-nav-link:active,
  .mobile-appliance-link:hover,
  .mobile-appliance-link:focus-visible,
  .mobile-appliance-link:active {
    color: #f4f5f7;
    text-shadow: 0 0 8px rgba(244, 245, 247, 0.28);
  }

  .menu-icon-close {
    display: none;
  }

  [data-mobile-menu-toggle][aria-expanded='true'] .menu-icon-bars {
    display: none;
  }

  [data-mobile-menu-toggle][aria-expanded='true'] .menu-icon-close {
    display: block;
  }
</style>

<script>
  const siteHeader = document.querySelector('[data-site-header]');
  const utilityEl = siteHeader?.querySelector('[data-header-utility]');
  const mainEl = siteHeader?.querySelector('[data-header-main]');

  const measureUtilityHeight = () => {
    if (!utilityEl || !siteHeader || window.innerWidth < 768) return 0;
    const wasCompact = siteHeader.classList.contains('is-compact');
    if (wasCompact) siteHeader.classList.remove('is-compact');
    const height = Math.ceil(utilityEl.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--header-utility-h', `${height}px`);
    if (wasCompact) siteHeader.classList.add('is-compact');
    return height;
  };

  const syncHeaderSpace = () => {
    if (!siteHeader) return;
    if (window.innerWidth >= 768) {
      const wasCompact = siteHeader.classList.contains('is-compact');
      if (wasCompact) siteHeader.classList.remove('is-compact');
      const fullHeight = Math.ceil(siteHeader.getBoundingClientRect().height);
      const utilityHeight = utilityEl ? Math.ceil(utilityEl.getBoundingClientRect().height) : 0;
      const mainHeight = mainEl
        ? Math.ceil(mainEl.getBoundingClientRect().height)
        : Math.max(fullHeight - utilityHeight, 0);
      document.documentElement.style.setProperty('--header-utility-h', `${utilityHeight}px`);
      if (wasCompact) siteHeader.classList.add('is-compact');
      // Compact: pad only the visible main bar (removes air under sticky header)
      document.documentElement.style.setProperty(
        '--site-header',
        `${wasCompact ? mainHeight : fullHeight}px`,
      );
      return;
    }
    const menuPanel = siteHeader.querySelector('[data-mobile-menu-panel]');
    let height = siteHeader.getBoundingClientRect().height;
    if (menuPanel && !menuPanel.hidden) {
      height -= menuPanel.getBoundingClientRect().height;
    }
    document.documentElement.style.setProperty('--site-header', `${Math.ceil(height)}px`);
  };

  const syncCompactHeader = () => {
    if (!siteHeader) return;
    if (window.innerWidth < 768) {
      if (siteHeader.classList.contains('is-compact')) {
        siteHeader.classList.remove('is-compact');
        syncHeaderSpace();
      } else {
        syncHeaderSpace();
      }
      return;
    }

    const scrolled = window.scrollY;
    const wasCompact = siteHeader.classList.contains('is-compact');
    const compact = wasCompact ? scrolled > 12 : scrolled > 48;
    if (compact === wasCompact) return;

    const utilityHeight =
      parseInt(
        getComputedStyle(document.documentElement).getPropertyValue('--header-utility-h'),
        10,
      ) || measureUtilityHeight();

    siteHeader.classList.toggle('is-compact', compact);
    syncHeaderSpace();
    // Compensate padding change so the page does not jump
    if (utilityHeight > 0) {
      window.scrollBy(0, compact ? -utilityHeight : utilityHeight);
    }
  };

  measureUtilityHeight();
  syncHeaderSpace();
  syncCompactHeader();
  window.addEventListener('resize', () => {
    measureUtilityHeight();
    syncHeaderSpace();
    syncCompactHeader();
  });
  window.addEventListener('scroll', syncCompactHeader, { passive: true });

  const mobileHeader = document.querySelector('[data-mobile-header]');
  if (mobileHeader) {
    const menuPanel = mobileHeader.querySelector('[data-mobile-menu-panel]');
    const menuToggles = mobileHeader.querySelectorAll('[data-mobile-menu-toggle]');
    const setMenuOpen = (open) => {
      menuPanel.hidden = !open;
      menuToggles.forEach((button) => button.setAttribute('aria-expanded', open ? 'true' : 'false'));
      syncHeaderSpace();
    };
    menuToggles.forEach((button) => {
      button.addEventListener('click', () => setMenuOpen(menuPanel.hidden));
    });
    document.addEventListener('click', (event) => {
      if (!mobileHeader.contains(event.target)) setMenuOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });

    mobileHeader.querySelectorAll('[data-mobile-submenu]').forEach((submenu) => {
      const toggle = submenu.querySelector('[data-mobile-submenu-toggle]');
      const panel = submenu.querySelector('[data-mobile-submenu-panel]');
      const chevron = submenu.querySelector('[data-mobile-submenu-chevron]');
      if (!toggle || !panel) return;
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.hidden = !open;
        chevron?.classList.toggle('rotate-180', open);
      });
    });
  }
</script>

---
import { siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  buttonClass?: string;
  wrapClass?: string;
  placement?: 'top' | 'bottom';
}

const {
  locale,
  buttonClass =
    'btn-outline-glow inline-flex h-12 w-full items-center justify-center rounded-DEFAULT border px-8 font-tech text-tech-data uppercase tracking-wider text-text-primary sm:w-auto',
  wrapClass = 'relative inline-flex w-full sm:w-auto',
  placement = 'bottom',
} = Astro.props;
---

<div
  class={wrapClass}
  data-call-phone-picker
  data-placement={placement}
>
  <div class="grid w-full grid-cols-[minmax(max-content,1fr)]">
    <button
      type="button"
      data-call-phone-trigger
      class:list={[buttonClass, 'col-start-1 row-start-1 !w-full !max-w-none']}
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      {t(locale, 'cta.call')}
    </button>
    <div
      aria-hidden="true"
      data-call-phone-sizer
      class="pointer-events-none invisible col-start-1 row-start-1 h-0 min-h-0 w-max justify-self-start self-start overflow-hidden"
    >
      <div class="w-max border p-3">
        <p class="mb-2 px-1 text-label-caps">{t(locale, 'cta.call')}</p>
        <div class="grid w-max grid-cols-[max-content_max-content] gap-x-1.5 px-1 font-tech text-tech-data tabular-nums">
          {
            siteConfig.phones.map((phone) => (
              <span class="col-span-2 grid grid-cols-subgrid whitespace-nowrap py-1.5">
                <span class="text-right">{phone.prefix}</span>
                <span>{phone.rest}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div
    data-call-phone-panel
    role="dialog"
    aria-label={t(locale, 'cta.call')}
    hidden
    class="btn-outline-glow fixed z-[150] hidden border bg-[#14171d] p-3"
  >
    <p class="text-label-caps text-primary mb-2 px-1">{t(locale, 'cta.call')}</p>
    <div class="grid w-max grid-cols-[max-content_max-content] gap-x-1.5 px-1 font-tech text-tech-data tabular-nums">
      {
        siteConfig.phones.map((phone) => (
          <a
            href={phone.href}
            class="col-span-2 grid grid-cols-subgrid whitespace-nowrap py-1.5 text-text-primary hover:text-primary transition-colors"
          >
            <span class="text-right">{phone.prefix}</span>
            <span>{phone.rest}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { initCallPhonePickers } from '../scripts/call-phone-picker';
  initCallPhonePickers();
</script>

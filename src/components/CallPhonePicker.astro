---
import { siteConfig, type Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  buttonClass?: string;
  wrapClass?: string;
  placement?: 'top' | 'bottom';
  showIcon?: boolean;
  fitParent?: boolean;
  iconOnly?: boolean;
  label?: string;
}

const callButtonType =
  'btn-lead-glow inline-flex items-center justify-center rounded-DEFAULT border border-primary/50 bg-[#181b22]/65 font-tech text-tech-data font-semibold uppercase tracking-wider text-[#f4f5f7] backdrop-blur-md hover:bg-[#181b22]/80';

const {
  locale,
  buttonClass = 'h-12 w-full px-8 sm:w-auto',
  wrapClass = 'relative inline-flex w-full sm:w-auto',
  placement = 'bottom',
  showIcon = false,
  fitParent = false,
  iconOnly = false,
  label,
} = Astro.props;
const buttonLabel = label || t(locale, 'cta.call');
---

<div
  class={wrapClass}
  data-call-phone-picker
  data-placement={placement}
  data-fit={fitParent ? 'parent' : undefined}
  data-icon-only={iconOnly ? 'true' : undefined}
>
  <div class:list={[iconOnly ? 'inline-flex' : 'grid w-full grid-cols-[minmax(max-content,1fr)]']}>
    <button
      type="button"
      data-call-phone-trigger
      class:list={[
        iconOnly
          ? 'btn-lead-glow inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-DEFAULT border border-primary/50 bg-[#181b22]/65 text-primary backdrop-blur-md hover:bg-[#181b22]/80'
          : [callButtonType, buttonClass, 'col-start-1 row-start-1 !w-full !max-w-none'],
      ]}
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label={iconOnly ? t(locale, 'cta.call') : undefined}
    >
      {
        (showIcon || iconOnly) && (
          <svg class={iconOnly ? 'h-4 w-4' : 'h-3.5 w-3.5 shrink-0 text-primary'} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        )
      }
      {!iconOnly && buttonLabel}
    </button>
    <div
      aria-hidden="true"
      data-call-phone-sizer
      class:list={[
        'pointer-events-none invisible h-0 min-h-0 w-max overflow-hidden',
        iconOnly ? 'absolute' : 'col-start-1 row-start-1 justify-self-start self-start',
      ]}
    >
      <div class="w-max border p-3">
        <div class="grid w-max grid-cols-[max-content_max-content] gap-x-1.5 px-1 font-tech text-tech-data tabular-nums">
          {
            siteConfig.phones.map((phone) => (
              <span class="col-span-2 grid grid-cols-subgrid whitespace-nowrap py-1.5">
                <span class="text-right">{phone.prefix}</span>
                <span>{phone.rest}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div
    data-call-phone-panel
    role="dialog"
    aria-label={buttonLabel}
    hidden
    class="btn-outline-glow fixed z-[150] hidden border bg-[#14171d] p-3"
  >
    <div class="grid w-max grid-cols-[max-content_max-content] gap-x-1.5 px-1 font-tech text-tech-data tabular-nums">
      {
        siteConfig.phones.map((phone) => (
          <a
            href={phone.href}
            class="col-span-2 grid grid-cols-subgrid whitespace-nowrap py-1.5 text-text-primary hover:text-primary transition-colors"
          >
            <span class="text-right">{phone.prefix}</span>
            <span>{phone.rest}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { initCallPhonePickers } from '../scripts/call-phone-picker';
  initCallPhonePickers();
</script>

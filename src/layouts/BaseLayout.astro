---
import '../styles/global.css';
import { siteConfig, type Locale } from '../config/site';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
}

const locale = Astro.props.locale ?? 'ru';
const title = Astro.props.title ?? siteConfig.workingTitle[locale];
const description = Astro.props.description ?? siteConfig.tagline[locale];
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-surface-base text-text-primary antialiased">
    <slot />
  </body>
</html>

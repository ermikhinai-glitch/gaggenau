---
import '../styles/global.css';
import { siteConfig, type Locale } from '../config/site';
import { defaultOgImagePath } from '../content/seo';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const locale = Astro.props.locale ?? 'ru';
const title = Astro.props.title ?? siteConfig.workingTitle[locale];
const description = Astro.props.description ?? siteConfig.tagline[locale];
const noindex = Astro.props.noindex ?? false;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImagePath = Astro.props.ogImage ?? defaultOgImagePath;
const ogImage = new URL(ogImagePath, site).href;
const ogLocale = locale === 'ru' ? 'ru_RU' : 'en_US';
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.workingTitle[locale]} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@800&family=Plus+Jakarta+Sans:wght@500;600&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface-base text-text-primary antialiased">
    <a class="skip-link" href="#main-content">
      {locale === 'ru' ? 'К содержанию' : 'Skip to content'}
    </a>
    <slot />
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PromoBanner from '../components/PromoBanner.astro';
import MobileStickyBar from '../components/MobileStickyBar.astro';
import LeadModal from '../components/LeadModal.astro';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  showPromo?: boolean;
  applianceSlug?: string;
  applianceLabel?: string;
}

const {
  locale,
  title,
  description,
  showPromo = true,
  applianceSlug,
  applianceLabel,
} = Astro.props;
---

<BaseLayout locale={locale} title={title} description={description}>
  <Header
    locale={locale}
    applianceSlug={applianceSlug}
    applianceLabel={applianceLabel}
  />
  <main class="min-h-screen pt-20 pb-[5.5rem] md:pb-0">
    <slot />
    {
      showPromo && (
        <PromoBanner
          locale={locale}
          applianceSlug={applianceSlug}
          applianceLabel={applianceLabel}
        />
      )
    }
  </main>
  <Footer locale={locale} />
  <MobileStickyBar
    locale={locale}
    applianceSlug={applianceSlug}
    applianceLabel={applianceLabel}
  />
  <LeadModal locale={locale} />
</BaseLayout>
